# direnv: this project's environment, loaded when you cd in (`direnv allow` once).
# Real keys come from the fleet's sops store, decrypted on the fly — never written to a file:
# eval "$(secrets env --only POSTHOG_KEY=posthog.__NAME__)"
#
# .env.local holds local, non-secret values only (a local database file, test-mode keys).
dotenv_if_exists .env.local
