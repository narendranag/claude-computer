# direnv: this project's keys come from the fleet's sops store, never from a file
# (~/claude-computer/docs/DEV-GUIDELINES.md, "Secrets"). Run `direnv allow` once.
#
# One ENV_VAR=<name>.<field> per key (a well-known name such as OPENAI_API_KEY needs no mapping).
# Each is loaded on its own: a key not stored yet is reported and skipped, and the rest still load.
# Store one with `secrets set <name>.<field>` in your own terminal.
#
# Local, non-secret values (a local database file, URLs, test-mode keys) go in .env.local, loaded last.

keys=""   # e.g. "OPENAI_API_KEY POSTHOG_KEY=posthog.__NAME__"

if has secrets; then
  for pair in $keys; do
    if loaded="$(secrets env --only "$pair" 2>/dev/null)"; then
      eval "$loaded"
    else
      log_status "not in the secrets store yet: ${pair#*=} (for ${pair%%=*})"
    fi
  done
else
  log_error "secrets is not on the PATH (~/claude-computer/bin); keys were not loaded"
fi

dotenv_if_exists .env.local
