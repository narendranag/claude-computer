# justfile — setup / test / lint / run are the contract every repo keeps.

setup:
    uv sync

test:
    uv run pytest

lint:
    uv run ruff check . && uv run ruff format --check . && uv run pyright
    docs-build --check docs

run *args:
    uv run __NAME__ {{args}}

install:
    uv tool install --force .
