# justfile — setup / test / lint / run are the contract every repo keeps.

setup:
    pnpm install

dev:
    pnpm dev

test:
    pnpm vitest run

e2e:
    pnpm exec playwright test

lint:
    pnpm biome check .
    docs-build --check docs

run: dev

# The production build under Cloudflare's runtime, locally (OpenNext + wrangler).
preview:
    pnpm run preview

# OpenNext build + wrangler deploy to Workers. `pnpm run deploy`, never `pnpm deploy` (pnpm's own command).
deploy:
    pnpm run deploy
