# Brewfile.dev — build machines, on top of Brewfile.
# Install: brew bundle --file Brewfile.dev

cask "orbstack"                         # Docker for Python services and self-hosted things
                                        # deliberately also in Brewfile.server — one role layer per machine
# darktable (RAW processing, library/camera brain) is an optional manual install — /setup phase 6.
# Homebrew disabled its cask on 2026-09-01: the build fails Gatekeeper.
cask "calibre"                          # books and comics libraries

brew "cloudflare-wrangler"              # Cloudflare Workers, D1, R2, DNS
brew "biome"
brew "ruff"
brew "pyright"                          # also the language server for the pyright-lsp Claude Code plugin
brew "typescript-language-server"       # for the typescript-lsp Claude Code plugin (brings typescript)
brew "mermaid-cli"                      # diagrams (mmdc)
brew "ccusage"                          # Claude Code usage

mas "Xcode", id: 497799835              # needs an Apple ID signed in to the App Store
