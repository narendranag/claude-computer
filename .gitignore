# ---------------------------------------------------------------
# This is a PUBLIC template. Nothing personal may be committed.
# ---------------------------------------------------------------

# Local working notes — never part of the template
*.zip
_private/

# Machine files: only the example ships. Real ones belong in the private instance.
docs/machines/*
!docs/machines/_example.md

# The secrets store: only its README and example ship in the template. /setup deletes this
# block in an instance, where secrets/secrets.yaml (sops-encrypted), secrets/backup.pub and
# .sops.yaml are committed. See secrets/README.md.
secrets/*
!secrets/README.md
!secrets/secrets.example.yaml
.sops.yaml
# end of the secrets-store block

# Secrets — plaintext never on disk in a repo. The store above is the one encrypted exception.
.env
.env.*
!.env.example
.envrc.local
*.pem
*.key
*.p12
*.age
id_rsa*
id_ed25519*
credentials.json
token.json
*.token
keys.txt
.secrets/
rclone.conf
bw-session*

# Browser profiles hold logged-in sessions — never in a repo
**/browse/profiles/

# Generated/personal state
INDEX.md
!templates/**/INDEX.md
*.log
.claude/settings.local.json
.claude/worktrees/

# Tooling
node_modules/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
dist/
build/

# OS / editor
.DS_Store
.AppleDouble
Icon?
._*
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

# wrangler scratch
.wrangler/
