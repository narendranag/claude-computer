# ~/.zshrc — linked from ~/claude-computer/dotfiles/zshrc. Local overrides: ~/.zshrc.local

# --- oh-my-zsh (installed by /setup) ---------------------------------------
export OH_MY_ZSH="$HOME/.oh-my-zsh"
if [ -d "$OH_MY_ZSH" ]; then
  export ZSH="$OH_MY_ZSH"
  ZSH_THEME=""                          # starship draws the prompt
  DISABLE_AUTO_TITLE=true               # the tab title is set below
  source "$ZSH/oh-my-zsh.sh"
fi

# --- Homebrew --------------------------------------------------------------
if [ -x /opt/homebrew/bin/brew ]; then eval "$(/opt/homebrew/bin/brew shellenv)"; fi
HOMEBREW_PREFIX="${HOMEBREW_PREFIX:-/usr/local}"

# --- PATH: the fleet brain's scripts ---------------------------------------
export CC_HOME="$HOME/claude-computer"
export PATH="$CC_HOME/bin:$HOME/.local/bin:$PATH"

# --- History -----------------------------------------------------------------
HISTSIZE=100000
SAVEHIST=100000
setopt SHARE_HISTORY HIST_IGNORE_DUPS HIST_IGNORE_SPACE

# --- Tools -----------------------------------------------------------------
command -v mise    >/dev/null && eval "$(mise activate zsh)"
command -v direnv  >/dev/null && eval "$(direnv hook zsh)"
command -v zoxide  >/dev/null && eval "$(zoxide init zsh)"
command -v fzf     >/dev/null && source <(fzf --zsh)
command -v starship >/dev/null && eval "$(starship init zsh)"
ZLE_RPROMPT_INDENT=0                    # right prompt ends in the last column, so the frame's corners line up

# --- Tab title: the client, project or product this shell is in --------------
# ~/clients|projects|products/<name>/… → <name>; a worktree (<name>.wt/<branch>) → <name> ⎇ <branch>;
# elsewhere under ~ → its top folder (claude-computer, vault). Over ssh, prefixed with the host.
# `tabtitle <text>` pins a title for this tab; `tabtitle` with nothing goes back to automatic.
_tab_label() {
  [[ -n "$TAB_TITLE" ]] && { print -r -- "$TAB_TITLE"; return; }
  local name rel="${PWD#$HOME/}"
  if [[ "$PWD" == "$HOME" ]]; then name="~"
  elif [[ "$rel" == "$PWD" ]]; then name="${PWD:t}"
  else
    local -a parts=("${(@s:/:)rel}")
    case "${parts[1]}" in clients|projects|products) shift parts ;; esac
    name="${parts[1]:-${PWD:t}}"
    [[ "$name" == *.wt && -n "${parts[2]}" ]] && name="${name%.wt} ⎇ ${parts[2]}"
  fi
  [[ -n "$SSH_CONNECTION" ]] && name="${HOST%%.*}: $name"
  print -r -- "$name"
}
_tab_title() { printf '\e]2;%s\a' "$(_tab_label)"; }
tabtitle() { TAB_TITLE="$*"; _tab_title; }
autoload -Uz add-zsh-hook
add-zsh-hook precmd _tab_title

for p in zsh-autosuggestions zsh-syntax-highlighting; do
  f="$HOMEBREW_PREFIX/share/$p/$p.zsh"
  [ -r "$f" ] && source "$f"
done

# --- Aliases -----------------------------------------------------------------
# Never alias a standard command name (ls, cat, grep, find, cd). Claude Code copies these
# aliases into its own shell, where a model types `ls -lt` or `cat -A` and expects the real
# tool: eza and bat read those flags differently, or fail. New names only.
alias ll='eza -l --git --group-directories-first'
alias lg='lazygit'
alias cchome='cd "$CC_HOME"'

export EDITOR="code --wait"

[ -r "$HOME/.zshrc.local" ] && source "$HOME/.zshrc.local"
