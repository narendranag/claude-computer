# Ghostty — linked to ~/.config/ghostty/config.ghostty. Solarized Dark with MesloLGS Nerd Font Mono
# (the font-meslo-lg-nerd-font cask), every window attached to one herdr session, ⌘ shortcuts
# remapped to herdr, and a quick terminal on ⌥Space. Check after editing: `ghostty +validate-config`.

# Look
font-family = MesloLGS Nerd Font Mono
font-size = 14
theme = iTerm2 Solarized Dark
window-padding-x = 8
window-padding-y = 6
macos-titlebar-style = tabs

# Behaviour
# herdr keeps the session; restored Ghostty windows would each open a duplicate workspace
window-save-state = never
window-inherit-working-directory = true
macos-option-as-alt = true
copy-on-select = clipboard
confirm-close-surface = false
scrollback-limit = 100000000
shell-integration = zsh
shell-integration-features = cursor,sudo,title,ssh-env,ssh-terminfo

# herdr — every window (and the quick terminal) attaches to one persistent herdr session,
# whose sidebar tracks each agent: working / blocked / done / idle. To get a plain shell back,
# comment out `command` and reload (⌘⇧,).
command = /opt/homebrew/bin/herdr

# ⌘ shortcuts drive herdr, not Ghostty's own tabs and splits: each sends herdr's prefix
# (ctrl+b = \x02) and a key. Needs herdr's prefix left at ctrl+b (dotfiles/herdr.toml).
keybind = cmd+t=text:\x02c
keybind = cmd+w=text:\x02x
keybind = cmd+shift+w=text:\x02X
keybind = cmd+d=text:\x02v
keybind = cmd+shift+d=text:\x02-
keybind = cmd+one=text:\x021
keybind = cmd+two=text:\x022
keybind = cmd+three=text:\x023
keybind = cmd+four=text:\x024
keybind = cmd+five=text:\x025
keybind = cmd+six=text:\x026
keybind = cmd+seven=text:\x027
keybind = cmd+eight=text:\x028
keybind = cmd+nine=text:\x029
keybind = cmd+left_bracket=text:\x02p
keybind = cmd+right_bracket=text:\x02n
keybind = cmd+alt+left=text:\x02h
keybind = cmd+alt+down=text:\x02j
keybind = cmd+alt+up=text:\x02k
keybind = cmd+alt+right=text:\x02l
keybind = cmd+shift+enter=text:\x02z
keybind = cmd+b=text:\x02b
keybind = cmd+k=text:\x02\x0b
keybind = cmd+j=text:\x02o
keybind = cmd+o=text:\x02w
keybind = cmd+shift+n=text:\x02N

# Quick terminal: a drop-down from the top on ⌥Space, from any app (needs Accessibility permission)
keybind = global:alt+space=toggle_quick_terminal
quick-terminal-position = top
