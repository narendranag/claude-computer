# ~/.config/ghostty/config.ghostty — linked from ~/claude-computer/dotfiles/ghostty.config
# Note: files in ~/Library/Application Support/com.mitchellh.ghostty/ load after this one and win; keep that folder empty.
# Reference: `ghostty +show-config --default --docs`

font-family = JetBrainsMono Nerd Font
font-size = 14
theme = light:Builtin Solarized Light,dark:Builtin Solarized Dark
window-padding-x = 8
window-padding-y = 6
window-save-state = always
macos-option-as-alt = true
copy-on-select = clipboard
shell-integration = zsh
confirm-close-surface = false
scrollback-limit = 100000000

keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
