#!/usr/bin/env bash
# jina — read a URL as markdown, or search the web, via Jina Reader.
#
# Usage:
#   jina <url>                 page → markdown (r.jina.ai)
#   jina --search "query"      search → markdown results (s.jina.ai)
#   jina ... --json            JSON response instead of markdown
#
# Secret: Bitwarden item "claude-computer/jina", password field = API key.
# Reader works without a key at a low rate limit; set JINA_NO_KEY=1 to skip Bitwarden.
# Exit codes: 0 ok · 1 API error · 2 usage · 3 curl/bw missing · 4 locked · 5 item missing
set -euo pipefail
. "$(dirname "$0")/../lib/common.sh"
cc_wants_help "$@"
cc_need curl

search=0; json=0; arg=""
while [ $# -gt 0 ]; do
  case "$1" in
    --search) search=1; shift ;;
    --json) json=1; shift ;;
    -*) cc_usage >&2; exit "$EX_USAGE" ;;
    *) arg="${arg:+$arg }$1"; shift ;;
  esac
done
[ -n "$arg" ] || { cc_usage >&2; exit "$EX_USAGE" ; }

accept="Accept: text/plain"
[ "$json" -eq 1 ] && accept="Accept: application/json"

if [ "$search" -eq 1 ]; then
  target="https://s.jina.ai/?q=$(jq -rn --arg q "$arg" '$q|@uri')"
else
  target="https://r.jina.ai/$arg"
fi

if [ "${JINA_NO_KEY:-0}" = "1" ]; then
  curl -sS --fail-with-body --max-time 60 -H "$accept" "$target" || exit "$EX_FAIL"
else
  key="$(cc_secret jina)"
  cc_curl "Authorization: Bearer $key" -H "$accept" "$target" || exit "$EX_FAIL"
fi
