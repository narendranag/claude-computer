#!/usr/bin/env bash
# secrets-unlock — unlock Bitwarden once, share the session with every bin/ wrapper.
#
# Usage:
#   secrets-unlock            unlock if locked (prompts for the master password); no-op if unlocked
#   secrets-unlock --status   print unauthenticated | locked | unlocked; exit 0 only if unlocked
#   secrets-unlock --export   print `export BW_SESSION=...` for eval in an interactive shell
#   secrets-unlock --lock     lock the vault and forget the stored session
#   secrets-unlock --check    report which expected items exist (names only; never reads a value)
#
# The session token is kept in the macOS login Keychain (Linux: $XDG_RUNTIME_DIR),
# never in a persistent plaintext file. Wrappers load it automatically.
#
# Exit codes: 0 ok · 2 usage · 3 bw/jq missing · 4 not logged in / still locked · 5 (--check) items missing
set -euo pipefail
. "$(dirname "$0")/../lib/common.sh"
cc_wants_help "$@"

# Bitwarden is on its way out (bin/secrets replaces it); the session helpers that used to live
# in lib/common.sh are kept here, the only script still using them, until this one is removed.
CC_BW_PREFIX="${CC_BW_PREFIX:-claude-computer/}"
_CC_KC_SERVICE="claude-computer-bw-session"
_cc_runtime_file() { printf '%s/claude-computer-bw-session' "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"; }
cc_session_load() {
  [ -n "${BW_SESSION:-}" ] && return 0
  local s=""
  if cc_is_macos; then
    s="$(security find-generic-password -a "$USER" -s "$_CC_KC_SERVICE" -w 2>/dev/null || true)"
  else
    local f; f="$(_cc_runtime_file)"
    [ -r "$f" ] && s="$(cat "$f")"
  fi
  [ -n "$s" ] && export BW_SESSION="$s"
  return 0
}
cc_session_store() {
  local s="$1"
  if cc_is_macos; then
    # `security -i` reads its commands from stdin, so the token is never in argv.
    local q="$s"
    q="${q//\\/\\\\}"; q="${q//\"/\\\"}"
    printf 'add-generic-password -U -a "%s" -s "%s" -w "%s"\n' "$USER" "$_CC_KC_SERVICE" "$q" |
      security -i >/dev/null
  else
    local f; f="$(_cc_runtime_file)"
    ( umask 077; printf '%s' "$s" > "$f" )
  fi
}
cc_session_clear() {
  if cc_is_macos; then
    security delete-generic-password -a "$USER" -s "$_CC_KC_SERVICE" >/dev/null 2>&1 || true
  else
    rm -f "$(_cc_runtime_file)"
  fi
}
cc_bw_status() {
  command -v bw >/dev/null 2>&1 || { echo "missing"; return; }
  cc_session_load
  bw status 2>/dev/null | jq -r '.status // "unauthenticated"' 2>/dev/null || echo "unauthenticated"
}

mode="unlock"
case "${1:-}" in
  "") ;;
  --status) mode="status" ;;
  --export) mode="export" ;;
  --lock)   mode="lock" ;;
  --check)  mode="check" ;;
  *) cc_usage >&2; exit "$EX_USAGE" ;;
esac

cc_need bw jq
status="$(cc_bw_status)"

case "$mode" in
  status)
    echo "$status"
    [ "$status" = "unlocked" ]; exit $?
    ;;
  lock)
    bw lock >/dev/null 2>&1 || true
    cc_session_clear
    echo "locked"
    exit "$EX_OK"
    ;;
esac

if [ "$status" = "unauthenticated" ]; then
  cc_die "$EX_LOCKED" "not logged in. Run \`bw login\` yourself first (it handles your credentials)."
fi

if [ "$status" != "unlocked" ]; then
  [ -t 0 ] || cc_die "$EX_LOCKED" "locked, and no terminal to prompt on. Run secrets-unlock in a terminal."
  session="$(bw unlock --raw)" || cc_die "$EX_LOCKED" "unlock failed"
  [ -n "$session" ] || cc_die "$EX_LOCKED" "unlock returned no session"
  cc_session_store "$session"
  export BW_SESSION="$session"
  bw sync >/dev/null 2>&1 || cc_info "warning: bw sync failed; using cached vault"
  cc_info "unlocked"
fi

if [ "$mode" = "check" ]; then
  missing=0
  for name in telegram tavily firecrawl jina exa r2 r2-crypt google-credentials; do
    # `bw get item` exit status says whether it exists; the JSON (which holds the value) goes to /dev/null.
    if bw get item "${CC_BW_PREFIX}${name}" >/dev/null 2>&1; then
      printf '  present  %s%s\n' "$CC_BW_PREFIX" "$name"
    else
      printf '  missing  %s%s\n' "$CC_BW_PREFIX" "$name"; missing=$((missing + 1))
    fi
  done
  [ "$missing" -eq 0 ] || exit "$EX_CONFIG"
  exit "$EX_OK"
fi

if [ "$mode" = "export" ]; then
  printf 'export BW_SESSION=%q\n' "$BW_SESSION"
fi
