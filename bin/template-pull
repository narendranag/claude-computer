#!/usr/bin/env bash
# template-pull — bring a release of the template into this instance.
#
# An instance made with "Use this template" shares no history with the template, so `git merge`
# refuses. This applies the template's own diff from the release the instance is on to the one you
# name, one file at a time: a file you never touched takes the template's version, a change you also
# made merges three-way (`git apply --3way --index`), a change already here is a no-op, and where you
# and the template changed the same lines the file is left with conflict markers. A file that can't be
# merged — the template adds one you already have with other contents, deletes one you changed, or
# changes one you deleted — is left as it is and listed with the command that takes the template's
# version; the rest of the release still applies. Nothing is committed.
#
# The release this instance is on is in .template-version, which the template ships and this script
# updates. An instance made before that file existed passes --from once: the release it was made
# from, or an earlier one if unsure (what is already here merges cleanly).
#
# Then it prints the CHANGELOG between the two releases. Read every "Migrating from" section: those
# are steps to do on each machine, after the commit.
#
# Usage:
#   template-pull                         the template's releases, newest first, and the one this is on
#   template-pull <tag> [--from <tag>]    apply <tag> (e.g. v0.6.0) to the working tree and index
#   template-pull <tag> --dry-run         the same in a throwaway worktree: what would change, and
#                                         which files would conflict; this one is left untouched
#
# Exit codes: 0 applied cleanly (or nothing to do) · 1 applied, with conflicts or files left for you
# (resolve them, then commit), or git failed · 2 usage, or uncommitted changes · 5 no `upstream`
# remote, an unknown tag, or no .template-version and no --from
set -euo pipefail
. "$(dirname "$0")/../lib/common.sh"
cc_wants_help "$@"
cc_need git

to="" from="" dry=0
while [ $# -gt 0 ]; do
  case "$1" in
    --from) [ -n "${2:-}" ] || cc_die "$EX_USAGE" "--from needs a tag"; from="$2"; shift 2 ;;
    --dry-run) dry=1; shift ;;
    -*) cc_usage >&2; exit "$EX_USAGE" ;;
    *) [ -z "$to" ] || cc_die "$EX_USAGE" "one tag at a time"; to="$1"; shift ;;
  esac
done

repo="$(git -C "$CC_ROOT" rev-parse --show-toplevel 2>/dev/null)" || cc_die "$EX_CONFIG" "$CC_ROOT is not a git repo"
g() { git -C "$repo" "$@"; }
[ ! -f "$repo/.template" ] || cc_die "$EX_USAGE" "this is the template itself, not an instance (.template exists)"
g remote get-url upstream > /dev/null 2>&1 \
  || cc_die "$EX_CONFIG" "no 'upstream' remote. Add it fetch-only: git remote add upstream \"\$(cat UPSTREAM)\" && git remote set-url --push upstream DISABLED"

# The template's tags go under refs/template/, never refs/tags/: the instance's own tags stay its own.
g fetch -q --no-tags upstream '+refs/tags/v*:refs/template/v*' || cc_die "$EX_FAIL" "git fetch upstream failed"
have() { g rev-parse -q --verify "refs/template/$1^{commit}" > /dev/null; }
releases() { g for-each-ref --sort=-v:refname --format='%(refname:strip=2)' refs/template/; }

current=""
[ ! -f "$repo/.template-version" ] || current="$(tr -d '[:space:]' < "$repo/.template-version")"

if [ -z "$to" ]; then
  releases | while read -r t; do
    if [ "$t" = "$current" ]; then echo "$t  ← this instance"; else echo "$t"; fi
  done
  [ -n "$current" ] || cc_info "(no .template-version here: pass --from <tag> the first time)"
  exit "$EX_OK"
fi

from="${from:-$current}"
[ -n "$from" ] || cc_die "$EX_CONFIG" "no .template-version: pass --from <the release this instance was made from>"
have "$to" || cc_die "$EX_CONFIG" "no template release $to (template-pull lists them)"
have "$from" || cc_die "$EX_CONFIG" "no template release $from (template-pull lists them)"
if [ "$from" = "$to" ]; then cc_info "already on $to"; exit "$EX_OK"; fi
g merge-base --is-ancestor "refs/template/$from" "refs/template/$to" || cc_die "$EX_USAGE" "$to is not after $from"
if ! g diff --quiet || ! g diff --cached --quiet; then
  cc_die "$EX_USAGE" "uncommitted changes: commit or stash them first"
fi

# One file at a time, because git apply is all or nothing: a single path it can't place fails the whole
# patch, and an instance that took part of a release by hand has many. Each path of the template's diff
# (renames as a delete and an add) is decided on its own; .template-version is written below, not
# patched. Apply in the work tree $1; print one line per path that needs the owner: "C path" a conflict,
# "X path" already here with other contents, "K path" deleted in the template but changed here,
# "F path" the patch would not apply, "S path" changed in the template but deleted here.
apply_in() {
  local dir="$1" st path here old new err
  err="$(mktemp "${TMPDIR:-/tmp}/template-pull-err.XXXXXX")"
  while IFS="$(printf '\t')" read -r st path; do
    [ "$path" = .template-version ] && continue
    here="$(git -C "$dir" rev-parse -q --verify "HEAD:$path" 2> /dev/null || true)"
    old="$(g rev-parse -q --verify "refs/template/$from:$path" 2> /dev/null || true)"
    new="$(g rev-parse -q --verify "refs/template/$to:$path" 2> /dev/null || true)"
    [ -n "$here" ] && [ "$here" = "$new" ] && continue # already the template's version
    case "$st" in
      A)
        if [ -z "$here" ]; then git -C "$dir" checkout -q "refs/template/$to" -- "$path"
        else echo "X $path"; fi ;;
      D)
        if [ -z "$here" ]; then continue # deleted here too
        elif [ "$here" = "$old" ]; then git -C "$dir" rm -q -- "$path"
        else echo "K $path"; fi ;;
      *)
        if [ -z "$here" ]; then echo "S $path"
        elif [ "$here" = "$old" ]; then git -C "$dir" checkout -q "refs/template/$to" -- "$path"
        elif g diff --binary "refs/template/$from" "refs/template/$to" -- ":(literal)$path" \
          | git -C "$dir" apply --3way --index > /dev/null 2> "$err"; then :
        elif [ -n "$(git -C "$dir" ls-files -u -- "$path")" ]; then echo "C $path"
        else echo "F $path"; sed 's/^/      /' "$err" >&2; fi ;;
    esac
  done < <(g diff --no-renames --name-status "refs/template/$from" "refs/template/$to")
  rm -f "$err"
}
indent() { sed 's/^/  /' >&2; }

# The report for apply_in's lines on stdin. Returns 1 when anything needs the owner.
report() {
  local out kind label rc=0
  out="$(cat)"
  for kind in C X K F S; do
    case "$kind" in
      C) label="Conflicts — resolve each, then git add it:"; [ "$dry" -eq 0 ] || label="would conflict:" ;;
      X) label="Added in the template, but already here with other contents — left as yours (compare: git diff HEAD refs/template/$to -- <path>; take the template's: git checkout refs/template/$to -- <path>):" ;;
      K) label="Deleted in the template, but changed here — kept (to delete it: git rm <path>):" ;;
      F) label="Would not apply — left as yours (take the template's: git checkout refs/template/$to -- <path>):" ;;
      S) label="Skipped — changed in the template, but deleted here (restore one with git checkout refs/template/$to -- <path>):" ;;
    esac
    printf '%s\n' "$out" | grep -q "^$kind " || continue
    cc_info "$label"
    printf '%s\n' "$out" | sed -n "s/^$kind //p" | indent
    [ "$kind" = S ] || rc=1
  done
  return "$rc"
}

changelog() {
  # Every section of the new release's CHANGELOG above the one for the release we came from.
  g show "refs/template/$to:CHANGELOG.md" 2>/dev/null | awk -v stop="## [${from#v}]" '
    index($0, stop) == 1 { exit }
    /^## \[/ && !/^## \[Unreleased\]/ { on = 1 }
    on { print }'
}

if [ "$dry" -eq 1 ]; then
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/template-pull.XXXXXX")"
  trap 'g worktree remove --force "$tmp/wt" > /dev/null 2>&1; rm -rf "$tmp"' EXIT
  g worktree add -q --detach "$tmp/wt" HEAD
  cc_info "template-pull: $from → $to, dry run (this working tree is untouched)"
  lines="$(apply_in "$tmp/wt")"
  git -C "$tmp/wt" diff --cached --stat | tail -1
  rc=0; printf '%s\n' "$lines" | report || rc=$?
  if [ "$rc" -ne 0 ]; then exit "$EX_FAIL"; fi
  cc_info "would apply cleanly"
  exit "$EX_OK"
fi

cc_info "template-pull: $from → $to"
lines="$(apply_in "$repo")"
printf '%s\n' "$to" > "$repo/.template-version"
g add .template-version

echo
changelog
echo
g diff --cached --stat | tail -1
rc=0; printf '%s\n' "$lines" | report || rc=$?
cc_info ""
cc_info "Next: review (git diff --cached), commit \"[$(cc_host)] template: $from → $to\", push, and do"
cc_info "every \"Migrating from\" step above on each machine. To back out: git reset --hard HEAD."
exit "$rc"
