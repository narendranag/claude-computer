#!/usr/bin/env bash
# template-pull — bring a release of the template into this instance.
#
# An instance made with "Use this template" shares no history with the template, so `git merge`
# refuses. This applies the template's own diff from the release the instance is on to the one you
# name (`git diff --binary <from> <to> | git apply --3way --index`): a change you also made merges
# three-way, a change already here applies as a no-op, and where you and the template changed the
# same lines the file is left with conflict markers. Nothing is committed.
#
# The release this instance is on is in .template-version, which the template ships and this script
# updates. An instance made before that file existed passes --from once: the release it was made
# from, or an earlier one if unsure (what is already here merges cleanly).
#
# Then it prints the CHANGELOG between the two releases. Read every "Migrating from" section: those
# are steps to do on each machine, after the commit.
#
# Usage:
#   template-pull                         the template's releases, newest first, and the one this is on
#   template-pull <tag> [--from <tag>]    apply <tag> (e.g. v0.6.0) to the working tree and index
#   template-pull <tag> --dry-run         the same in a throwaway worktree: what would change, and
#                                         which files would conflict; this one is left untouched
#
# Exit codes: 0 applied cleanly (or nothing to do) · 1 applied with conflicts (resolve them, then
# commit), or git failed · 2 usage, or uncommitted changes · 5 no `upstream` remote, an unknown tag,
# or no .template-version and no --from
set -euo pipefail
. "$(dirname "$0")/../lib/common.sh"
cc_wants_help "$@"
cc_need git

to="" from="" dry=0
while [ $# -gt 0 ]; do
  case "$1" in
    --from) [ -n "${2:-}" ] || cc_die "$EX_USAGE" "--from needs a tag"; from="$2"; shift 2 ;;
    --dry-run) dry=1; shift ;;
    -*) cc_usage >&2; exit "$EX_USAGE" ;;
    *) [ -z "$to" ] || cc_die "$EX_USAGE" "one tag at a time"; to="$1"; shift ;;
  esac
done

repo="$(git -C "$CC_ROOT" rev-parse --show-toplevel 2>/dev/null)" || cc_die "$EX_CONFIG" "$CC_ROOT is not a git repo"
g() { git -C "$repo" "$@"; }
[ ! -f "$repo/.template" ] || cc_die "$EX_USAGE" "this is the template itself, not an instance (.template exists)"
g remote get-url upstream > /dev/null 2>&1 \
  || cc_die "$EX_CONFIG" "no 'upstream' remote. Add it fetch-only: git remote add upstream \"\$(cat UPSTREAM)\" && git remote set-url --push upstream DISABLED"

# The template's tags go under refs/template/, never refs/tags/: the instance's own tags stay its own.
g fetch -q --no-tags upstream '+refs/tags/v*:refs/template/v*' || cc_die "$EX_FAIL" "git fetch upstream failed"
have() { g rev-parse -q --verify "refs/template/$1^{commit}" > /dev/null; }
releases() { g for-each-ref --sort=-v:refname --format='%(refname:strip=2)' refs/template/; }

current=""
[ ! -f "$repo/.template-version" ] || current="$(tr -d '[:space:]' < "$repo/.template-version")"

if [ -z "$to" ]; then
  releases | while read -r t; do
    if [ "$t" = "$current" ]; then echo "$t  ← this instance"; else echo "$t"; fi
  done
  [ -n "$current" ] || cc_info "(no .template-version here: pass --from <tag> the first time)"
  exit "$EX_OK"
fi

from="${from:-$current}"
[ -n "$from" ] || cc_die "$EX_CONFIG" "no .template-version: pass --from <the release this instance was made from>"
have "$to" || cc_die "$EX_CONFIG" "no template release $to (template-pull lists them)"
have "$from" || cc_die "$EX_CONFIG" "no template release $from (template-pull lists them)"
if [ "$from" = "$to" ]; then cc_info "already on $to"; exit "$EX_OK"; fi
g merge-base --is-ancestor "refs/template/$from" "refs/template/$to" || cc_die "$EX_USAGE" "$to is not after $from"
if ! g diff --quiet || ! g diff --cached --quiet; then
  cc_die "$EX_USAGE" "uncommitted changes: commit or stash them first"
fi

# git apply is all or nothing: one path it cannot find fails the whole patch. So paths this instance
# no longer has are left out — deleted here and in the template: done already; changed in the
# template but deleted here: skipped, and named, since keeping it deleted is the instance's call.
# .template-version is written below, not patched: the instance's copy may not match the base.
skipped="" excludes=":(exclude).template-version"
while IFS="$(printf '\t')" read -r st path; do
  case "$st" in A) continue ;; esac
  g cat-file -e "HEAD:$path" 2> /dev/null && continue
  excludes="$excludes"$'\n'":(exclude,literal)$path"
  [ "$st" = D ] || skipped="$skipped$path"$'\n'
done < <(g diff --no-renames --name-status "refs/template/$from" "refs/template/$to")
patch() {
  local -a ex=()
  while IFS= read -r e; do ex+=("$e"); done <<< "$excludes"
  g diff --no-renames --binary "refs/template/$from" "refs/template/$to" -- . "${ex[@]}"
}
report_skipped() {
  [ -n "$skipped" ] || return 0
  cc_info "Skipped — changed in the template, but deleted here (restore one with git checkout refs/template/$to -- <path>):"
  printf '%s' "$skipped" | indent
}

# Apply in the work tree $1. 0 clean · 1 conflicts, listed on stdout · 2 git apply failed outright.
apply_in() {
  local dir="$1" err rc=0 conflicts
  err="$(mktemp "${TMPDIR:-/tmp}/template-pull-err.XXXXXX")"
  patch | git -C "$dir" apply --3way --index > /dev/null 2> "$err" || rc=$?
  conflicts="$(git -C "$dir" diff --name-only --diff-filter=U)"
  if [ -n "$conflicts" ]; then rm -f "$err"; printf '%s\n' "$conflicts"; return 1; fi
  if [ "$rc" -ne 0 ]; then cat "$err" >&2; rm -f "$err"; return 2; fi
  rm -f "$err"
}
indent() { sed 's/^/  /' >&2; }

changelog() {
  # Every section of the new release's CHANGELOG above the one for the release we came from.
  g show "refs/template/$to:CHANGELOG.md" 2>/dev/null | awk -v stop="## [${from#v}]" '
    index($0, stop) == 1 { exit }
    /^## \[/ && !/^## \[Unreleased\]/ { on = 1 }
    on { print }'
}

if [ "$dry" -eq 1 ]; then
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/template-pull.XXXXXX")"
  trap 'g worktree remove --force "$tmp/wt" > /dev/null 2>&1; rm -rf "$tmp"' EXIT
  g worktree add -q --detach "$tmp/wt" HEAD
  cc_info "template-pull: $from → $to, dry run (this working tree is untouched)"
  rc=0; conflicts="$(apply_in "$tmp/wt")" || rc=$?
  [ "$rc" -ne 2 ] || cc_die "$EX_FAIL" "git apply failed: nothing would apply"
  git -C "$tmp/wt" diff --cached --stat | tail -1
  report_skipped
  if [ "$rc" -eq 1 ]; then
    cc_info "would conflict:"; printf '%s\n' "$conflicts" | indent
    exit "$EX_FAIL"
  fi
  cc_info "would apply cleanly"
  exit "$EX_OK"
fi

cc_info "template-pull: $from → $to"
rc=0; conflicts="$(apply_in "$repo")" || rc=$?
[ "$rc" -ne 2 ] || cc_die "$EX_FAIL" "git apply failed; nothing was changed"
printf '%s\n' "$to" > "$repo/.template-version"
g add .template-version

echo
changelog
echo
g diff --cached --stat | tail -1
report_skipped
if [ "$rc" -eq 1 ]; then
  cc_info ""
  cc_info "Conflicts — resolve each, then git add it:"
  printf '%s\n' "$conflicts" | indent
fi
cc_info ""
cc_info "Next: review (git diff --cached), commit \"[$(cc_host)] template: $from → $to\", push, and do"
cc_info "every \"Migrating from\" step above on each machine. To back out: git reset --hard HEAD."
exit "$rc"
