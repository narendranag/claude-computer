#!/usr/bin/env bash
# tg-send — send a plain-text Telegram message, prefixed with this machine's name.
#
# Usage:
#   tg-send "backup finished"
#   long-job 2>&1 | tail -20 | tg-send
#   tg-send --dry-run "text"     print what would be sent; needs no secrets
#
# Secrets (Bitwarden item "claude-computer/telegram"):
#   password field → bot token (from BotFather)
#   custom field "chat_id" → your chat id (message the bot, then read getUpdates)
#
# Output: "[<host>] <text>", truncated to Telegram's 4096-character limit.
# Exit codes: 0 sent · 1 Telegram rejected it · 2 no text · 3 missing curl/bw/jq · 4 locked · 5 item missing
set -euo pipefail
. "$(dirname "$0")/../lib/common.sh"
cc_wants_help "$@"

dry=0
if [ "${1:-}" = "--dry-run" ]; then dry=1; shift; fi

if [ $# -gt 0 ]; then
  text="$*"
elif [ ! -t 0 ]; then
  text="$(cat)"
else
  cc_usage >&2; exit "$EX_USAGE"
fi
[ -n "${text//[[:space:]]/}" ] || cc_die "$EX_USAGE" "empty message"

msg="[$(cc_host)] $text"
msg="${msg:0:4096}"

if [ "$dry" -eq 1 ]; then
  printf '%s\n' "$msg"
  exit "$EX_OK"
fi

cc_need curl jq
token="$(cc_secret telegram)"
chat_id="$(cc_secret telegram chat_id)"

# URL passed on stdin, not argv, so the token never shows up in `ps`.
resp="$(printf 'url = "https://api.telegram.org/bot%s/sendMessage"\n' "$token" |
  curl -sS --max-time 20 -K - \
    --data-urlencode "chat_id=$chat_id" \
    --data-urlencode "text=$msg" \
    --data-urlencode "disable_web_page_preview=true")" || cc_die "$EX_FAIL" "network error"

if [ "$(printf '%s' "$resp" | jq -r '.ok')" != "true" ]; then
  cc_die "$EX_FAIL" "telegram: $(printf '%s' "$resp" | jq -r '.description // "unknown error"')"
fi
