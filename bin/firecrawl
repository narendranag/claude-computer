#!/usr/bin/env bash
# firecrawl — scrape a URL to clean markdown via Firecrawl.
#
# Usage:
#   firecrawl <url> [--json] [--full]
#
#   --full   keep navigation, headers and footers (default: main content only)
#   --json   raw API response
#
# Secret: Bitwarden item "claude-computer/firecrawl", password field = API key.
# Env: FIRECRAWL_API (default https://api.firecrawl.dev/v2)
# Exit codes: 0 ok · 1 API error · 2 usage · 3 curl/jq/bw missing · 4 locked · 5 item missing
set -euo pipefail
. "$(dirname "$0")/../lib/common.sh"
cc_wants_help "$@"
cc_need curl jq

url=""; json=0; main=true
while [ $# -gt 0 ]; do
  case "$1" in
    --json) json=1; shift ;;
    --full) main=false; shift ;;
    -*) cc_usage >&2; exit "$EX_USAGE" ;;
    *) url="$1"; shift ;;
  esac
done
[ -n "$url" ] || { cc_usage >&2; exit "$EX_USAGE"; }

key="$(cc_secret firecrawl)"
body="$(jq -n --arg u "$url" --argjson m "$main" '{url:$u, formats:["markdown"], onlyMainContent:$m}')"
resp="$(cc_curl "Authorization: Bearer $key" -H 'Content-Type: application/json' \
  -d "$body" "${FIRECRAWL_API:-https://api.firecrawl.dev/v2}/scrape")" || cc_die "$EX_FAIL" "API error: $resp"

if [ "$json" -eq 1 ]; then printf '%s\n' "$resp"; exit 0; fi
printf '%s' "$resp" | jq -r '.data.markdown // empty'
