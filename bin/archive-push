#!/usr/bin/env bash
# archive-push — move folders from ~/archive to cold storage in R2, then rebuild INDEX.md.
#
# ~/archive is a staging area, not storage. Once pushed and verified, R2 holds the only copy.
#
# Usage:
#   archive-push <path>... [--delete-local [--yes]] [--dry-run]
#   archive-push --index-only
#
#   <path>          file or folder inside ~/archive (keeps its relative path in R2)
#   --delete-local  after a verified upload, remove the local copy. Without it, nothing is deleted.
#                   Asks before each deletion; there is no undo, R2 becomes the only copy.
#   --yes           answer that question yes. Needed when there is no terminal to ask on
#                   (a scheduled job); otherwise say yes yourself.
#   --dry-run       show what would be uploaded
#   --index-only    just rebuild ~/archive/INDEX.md from `rclone lsjson`
#
# Remote: r2:<bucket>/archive/  (credentials from Bitwarden, see docs/SECRETS.md)
# Env: CC_ARCHIVE (default ~/archive)
# Exit codes: 0 ok · 1 upload or verify failed · 2 usage · 3 rclone/jq missing · 4 locked · 5 config
set -euo pipefail
. "$(dirname "$0")/../lib/common.sh"
cc_wants_help "$@"
cc_need jq

ARCHIVE="${CC_ARCHIVE:-$HOME/archive}"
paths=(); delete=0; dry=0; index_only=0; assume_yes=0
while [ $# -gt 0 ]; do
  case "$1" in
    --delete-local) delete=1; shift ;;
    --yes|-y) assume_yes=1; shift ;;
    --dry-run) dry=1; shift ;;
    --index-only) index_only=1; shift ;;
    -*) cc_usage >&2; exit "$EX_USAGE" ;;
    *) paths+=("$1"); shift ;;
  esac
done
[ "$index_only" -eq 1 ] || [ "${#paths[@]}" -gt 0 ] || { cc_usage >&2; exit "$EX_USAGE"; }
[ -d "$ARCHIVE" ] || cc_die "$EX_CONFIG" "$ARCHIVE does not exist"

cc_r2_env
remote="r2:$CC_R2_BUCKET/archive"

rebuild_index() {
  local tmp; tmp="$(mktemp)"
  rclone lsjson -R --files-only "$remote" > "$tmp" || { rm -f "$tmp"; cc_die "$EX_FAIL" "lsjson failed"; }
  {
    echo "---"
    echo "type: index"
    echo "generated: archive-push"
    echo "updated: $(date -u +%Y-%m-%dT%H:%MZ)"
    echo "---"
    echo
    echo "# Archive index"
    echo
    echo "> Generated from \`rclone lsjson\` of R2. Do not edit. Rebuild: \`archive-push --index-only\`."
    echo
    echo "## Folders"
    echo
    echo "| Folder | Files | Size | Latest change |"
    echo "|---|---:|---:|---|"
    jq -r '
      group_by(.Path | split("/")[0]) | map({
        f: (.[0].Path | split("/")[0]),
        n: length,
        s: (map(.Size) | add),
        m: (map(.ModTime) | max | .[0:10])
      }) | sort_by(.f)[] |
      "| \(.f) | \(.n) | \(if .s > 1073741824 then "\((.s/1073741824*10|floor)/10) GB" elif .s > 1048576 then "\((.s/1048576*10|floor)/10) MB" else "\((.s/1024|floor)) KB" end) | \(.m) |"' "$tmp"
    echo
    echo "## Files"
    echo
    jq -r 'sort_by(.Path)[] | "- `\(.Path)` — \(.Size) B — \(.ModTime[0:10])"' "$tmp"
  } > "$ARCHIVE/INDEX.md"
  rm -f "$tmp"
  cc_info "index: $ARCHIVE/INDEX.md ($(grep -c '^- `' "$ARCHIVE/INDEX.md") files)"
}

if [ "$index_only" -eq 1 ]; then rebuild_index; exit "$EX_OK"; fi

archive_real="$(cd "$ARCHIVE" && pwd -P)"
for p in "${paths[@]}"; do
  [ -e "$p" ] || cc_die "$EX_USAGE" "no such path: $p"
  abs="$(cd "$(dirname "$p")" && pwd -P)/$(basename "$p")"
  case "$abs" in "$archive_real"/*) ;; *) cc_die "$EX_USAGE" "$p is not inside $ARCHIVE — move it there first" ;; esac
  rel="${abs#"$archive_real"/}"
  case "$rel" in CLAUDE.md|INDEX.md|TASKS.md) cc_die "$EX_USAGE" "refusing to archive the brain's own $rel" ;; esac

  if [ -d "$abs" ]; then src="$abs"; dst="$remote/$rel"; else src="$abs"; dst="$remote/$(dirname "$rel")"; fi
  [ "$dst" = "$remote/." ] && dst="$remote"

  cc_info "[$(cc_host)] push $rel → $dst"
  if [ "$dry" -eq 1 ]; then
    rclone copy --dry-run "$src" "$dst"
    continue
  fi
  rclone copy --checksum --progress "$src" "$dst" || cc_die "$EX_FAIL" "upload failed: $rel"
  if [ -d "$abs" ]; then
    rclone check --one-way "$abs" "$dst" || cc_die "$EX_FAIL" "verify failed: $rel (local copy kept)"
  else
    rclone check --one-way --include "/$(basename "$abs")" "$(dirname "$abs")" "$dst" || cc_die "$EX_FAIL" "verify failed: $rel (local copy kept)"
  fi
  if [ "$delete" -eq 1 ]; then
    # After this there is one copy, in R2. cc_confirm answers no when there is no
    # terminal, so an unattended run keeps the local copy unless --yes was passed.
    if [ "$assume_yes" -eq 1 ] || cc_confirm "delete the local copy of $rel? R2 will hold the only copy."; then
      rm -rf -- "$abs"
      cc_info "verified; removed local $rel"
    else
      cc_info "verified; local copy kept (not confirmed)"
    fi
  else
    cc_info "verified; local copy kept (pass --delete-local to remove)"
  fi
done

[ "$dry" -eq 1 ] || rebuild_index
