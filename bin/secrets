#!/usr/bin/env bash
# secrets — the machine-secret store: secrets/secrets.yaml, encrypted with sops to age keys.
#
# Usage:
#   secrets status                    key, store, recipient, backup key — no decryption
#   secrets check                     which expected secrets are set (names only, never a value)
#   secrets init [--first]            make this machine's age key and record its age_recipient;
#                                     --first also creates the empty store (first machine only)
#   secrets set <name.field> [--from-file PATH | --stdin]
#                                     store one value: a hidden prompt in a terminal (the only
#                                     way to type one), the file's contents, or stdin from a
#                                     program (--stdin). Never an argument.
#   secrets import-env <file> [--map NAME=name.field]… [--overwrite] [--dry-run]
#                                     import a dotenv file (NAME=value / export NAME=value);
#                                     prints names and counts only
#   secrets recipients [--check]      regenerate .sops.yaml from the machine files and
#                                     secrets/backup.pub; --check only reports drift
#   secrets admit <host>              re-encrypt the store to include <host> (run on a manager)
#   secrets revoke <host>             remove <host>, rotate the data key, list what to rotate
#   secrets push <box>                per-box files for headless boxes: designed, not built yet
#   secrets backup-key [--replace]    create the paper backup key (terminal only)
#   secrets backup-verify             type the paper key back; checks it opens the store
#   secrets env  (--only NAME[=name.field],… | --all-env)
#                                     print `export NAME='value'` lines, for eval in a terminal
#                                     or a direnv .envrc
#   secrets exec (--only NAME[=name.field],… | --all-env) -- <command> [args…]
#                                     run a command with those secrets in its environment
#
# A secret is <name>.<field> (`tavily.api_key`). In env/exec, NAME is an environment variable:
# well-known names map to the secrets the wrappers use (TAVILY_API_KEY → tavily.api_key,
# TELEGRAM_BOT_TOKEN → telegram.token, R2_ACCESS_KEY_ID → r2.access_key_id …); any other
# NAME is env.<name lowercased>, which is where import-env puts what it doesn't recognise.
# --all-env exports every env.* secret.
#
# Writes take a lock, then commit `[<host>] secrets: …` (--no-commit skips it) and push only if
# origin is a private GitHub repo. The key is ~/.config/sops/age/keys.txt (SOPS_AGE_KEY_FILE).
#
# Env: CC_SECRETS_FILE (default secrets/secrets.yaml) · SOPS_AGE_KEY_FILE
# Exit codes: 0 ok · 1 failed / plaintext in the store · 2 usage · 3 sops/age/jq missing or too
# old · 4 no age key, or this machine can't open the store · 5 no store / secret not set
set -euo pipefail
. "$(dirname "$0")/../lib/common.sh"
cc_wants_help "$@"

cmd="${1:-}"
[ -n "$cmd" ] || { cc_usage >&2; exit "$EX_USAGE"; }
shift

HOST="$(cc_host)"
MACHINES="$CC_ROOT/docs/machines"
BACKUP_PUB="$CC_ROOT/secrets/backup.pub"
EXAMPLE="$CC_ROOT/secrets/secrets.example.yaml"
REL_STORE="${CC_SECRETS_FILE#"$CC_ROOT"/}"
commit=1

# ---- helpers ----------------------------------------------------------------

file_mode() { if cc_is_macos; then stat -f '%Lp' "$1"; else stat -c '%a' "$1"; fi; }

need_tty() {
  [ -t 0 ] && [ -t 1 ] || cc_die "$EX_USAGE" "$1 needs a terminal: run it yourself, not through Claude"
}

lock() {
  LOCKDIR="${TMPDIR:-/tmp}/cc-secrets-$(id -u).lock"
  local i=0
  until mkdir "$LOCKDIR" 2>/dev/null; do
    i=$((i + 1))
    [ "$i" -lt 30 ] || cc_die "$EX_FAIL" "another secrets write holds $LOCKDIR (remove it if nothing is running)"
    sleep 1
  done
  trap 'rmdir "$LOCKDIR" 2>/dev/null || true' EXIT
}

in_git() { git -C "$CC_ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; }

# pull before a write, so two machines rarely race; only when there is an origin.
pull() {
  if [ "$commit" -eq 0 ] || ! in_git; then return 0; fi
  git -C "$CC_ROOT" remote get-url origin >/dev/null 2>&1 || return 0
  git -C "$CC_ROOT" pull -q --rebase --autostash ||
    cc_die "$EX_FAIL" "git pull failed — resolve it before changing secrets"
}

# commit_paths <message> <path>… — commit, then push only to a private origin.
commit_paths() {
  local msg="$1"; shift
  [ "$commit" -eq 1 ] || { cc_info "not committed (--no-commit): $*"; return 0; }
  in_git || { cc_info "not a git repo: nothing committed"; return 0; }
  git -C "$CC_ROOT" add -- "$@"
  if git -C "$CC_ROOT" diff --cached --quiet -- "$@"; then return 0; fi
  git -C "$CC_ROOT" commit -q -m "[$HOST] secrets: $msg" -- "$@" ||
    cc_die "$EX_FAIL" "commit failed (the pre-commit hook says why)"
  case "$(cc_remote_visibility "$CC_ROOT")" in
    PRIVATE | INTERNAL) git -C "$CC_ROOT" push -q || cc_err "push failed; the commit is local — push it yourself" ;;
    NONE) cc_info "committed; no origin to push to" ;;
    PUBLIC) cc_err "origin is PUBLIC — committed locally, NOT pushed. Make the repo private first." ;;
    *) cc_err "could not read origin's visibility — committed locally, not pushed. Check it, then git push." ;;
  esac
}

# machine_recipient <file> — age_recipient from a machine file's frontmatter.
machine_recipient() {
  awk 'NR == 1 && $0 != "---" {exit} NR > 1 && $0 == "---" {exit}
       /^age_recipient:/ {sub(/^age_recipient:[ ]*/, ""); sub(/[ ]+#.*$/, ""); gsub(/["'\'']/, ""); print; exit}' "$1"
}

# set_machine_recipient <file> <value> — write (or with "" remove) age_recipient in frontmatter.
set_machine_recipient() {
  local f="$1" v="$2" tmp
  tmp="$(mktemp "${f}.XXXXXX")"
  awk -v v="$v" '
    NR == 1 && $0 == "---" {fm = 1; print; next}
    fm && /^age_recipient:/ {if (v != "") print "age_recipient: " v; done = 1; next}
    fm && $0 == "---" {if (!done && v != "") print "age_recipient: " v; fm = 0; print; next}
    {print}' "$f" > "$tmp"
  mv "$tmp" "$f"
}

valid_recipient() { case "$1" in age1*) case "$1" in *[!a-z0-9]*) return 1 ;; esac; return 0 ;; *) return 1 ;; esac; }

# expected_recipients — "<label> <age1…>" lines: managers sorted by host, then the backup key.
expected_recipients() {
  local f h r
  for f in "$MACHINES"/*.md; do
    [ -f "$f" ] || continue
    h="$(basename "$f" .md)"
    [ "$h" = "_example" ] && continue
    r="$(machine_recipient "$f")"
    [ -n "$r" ] || continue
    valid_recipient "$r" || cc_die "$EX_CONFIG" "docs/machines/$h.md: age_recipient is not an age public key"
    printf '%s %s\n' "$h" "$r"
  done | sort
  if [ -f "$BACKUP_PUB" ]; then
    r="$(grep -m1 '^age1' "$BACKUP_PUB" || true)"
    valid_recipient "$r" || cc_die "$EX_CONFIG" "secrets/backup.pub holds no age public key"
    printf 'backup %s\n' "$r"
  fi
}

render_sops_config() {
  local list="$1" keys
  keys="$(printf '%s\n' "$list" | awk 'NF {print $2}' | paste -sd, -)"
  [ -n "$keys" ] || cc_die "$EX_CONFIG" "no recipients: no machine file has age_recipient, and no secrets/backup.pub"
  echo "# Generated by \`secrets recipients\` from each docs/machines/<host>.md age_recipient and"
  echo "# secrets/backup.pub. Don't edit by hand: change those and run \`secrets recipients\`."
  echo "#"
  printf '%s\n' "$list" | awk 'NF {printf "#   %-16s %s\n", $1, $2}'
  echo "creation_rules:"
  echo "  - path_regex: ^secrets/secrets\\.yaml\$"
  printf '    age: %s\n' "$keys"
}

write_sops_config() {
  local list
  list="$(expected_recipients)"
  render_sops_config "$list" > "$CC_SOPS_CONFIG.tmp"
  mv "$CC_SOPS_CONFIG.tmp" "$CC_SOPS_CONFIG"
}

store_needed() { [ -f "$CC_SECRETS_FILE" ] || cc_die "$EX_CONFIG" "no store at $REL_STORE. First machine: secrets init --first"; }

updatekeys() {
  (cd "$CC_ROOT" && sops --config "$CC_SOPS_CONFIG" updatekeys -y "$CC_SECRETS_FILE") >/dev/null 2>&1 ||
    cc_die "$EX_LOCKED" "sops updatekeys failed — this machine must be able to open the store (secrets status)"
}

# parse the --only / --all-env selection into SPEC (JSON: names and paths, never values).
parse_selection() {
  SPEC=""; ALL=0
  local only="" item n p
  while [ $# -gt 0 ]; do
    case "$1" in
      --only) only="${only:+$only,}${2:?--only needs NAME[,NAME…]}"; shift 2 ;;
      --all-env) ALL=1; shift ;;
      --) shift; break ;;
      *) cc_usage >&2; exit "$EX_USAGE" ;;
    esac
  done
  [ -n "$only" ] || [ "$ALL" -eq 1 ] || cc_die "$EX_USAGE" "say which secrets: --only NAME[,NAME…] or --all-env"
  SPEC="[]"
  local IFS=,
  for item in $only; do
    n="${item%%=*}"
    if [ "$n" != "$item" ]; then p="${item#*=}"; else p="$(cc_env_path "$n")"; fi
    case "$n" in "" | [0-9]* | *[!A-Za-z0-9_]*) cc_die "$EX_USAGE" "not an environment variable name: $n" ;; esac
    if [ "${p#*.}" = "$p" ] || ! cc_secret_name_ok "${p%%.*}" "${p#*.}"; then cc_die "$EX_USAGE" "not a secret name: $p"; fi
    SPEC="$(printf '%s' "$SPEC" | jq -c --arg n "$n" --arg k "${p%%.*}" --arg f "${p#*.}" '. + [{n: $n, k: $k, f: $f}]')"
  done
}

# export_lines — decrypt the store once and print `export NAME='value'` lines for SPEC / ALL.
# Fails with EX_CONFIG naming any secret that isn't set.
export_lines() {
  local json out
  cc_need sops jq
  store_needed
  [ -r "$SOPS_AGE_KEY_FILE" ] || cc_die "$EX_LOCKED" "no age key at $SOPS_AGE_KEY_FILE. Run: secrets init"
  json="$(sops decrypt --output-type json "$CC_SECRETS_FILE" 2>/dev/null)" ||
    cc_die "$EX_LOCKED" "this machine's age key can't open the store. On a manager: secrets admit $HOST"
  out="$(printf '%s' "$json" | jq -r --argjson spec "$SPEC" --argjson all "$ALL" '
    . as $r
    | ([$spec[] | . as $s | ($r[$s.k][$s.f] // "") as $v
        | if ($v | type) == "string" and $v != "" then {n: $s.n, v: $v} else {missing: "\($s.n) (\($s.k).\($s.f))"} end]
       + (if $all == 1 then [($r.env // {}) | to_entries[]
            | select(.key | test("^[a-z_][a-z0-9_]*$")) | select(.value | type == "string" and . != "")
            | {n: (.key | ascii_upcase), v: .value}] else [] end)) as $rows
    | if any($rows[]; has("missing")) then "MISSING " + ([$rows[] | .missing // empty] | join(", "))
      else $rows[] | "export \(.n)=\(.v | @sh)" end')"
  json=""
  case "$out" in MISSING\ *) cc_die "$EX_CONFIG" "not set: ${out#MISSING }" ;; esac
  printf '%s\n' "$out"
}

# ---- subcommands --------------------------------------------------------------

case "$cmd" in
  status)
    [ $# -eq 0 ] || { cc_usage >&2; exit "$EX_USAGE"; }
    rc=0
    if [ ! -f "$SOPS_AGE_KEY_FILE" ]; then
      echo "key:        none at $SOPS_AGE_KEY_FILE — run: secrets init"; rc="$EX_LOCKED"; pub=""
    else
      pub="$(cc_age_pub)"; mode="$(file_mode "$SOPS_AGE_KEY_FILE")"
      echo "key:        $SOPS_AGE_KEY_FILE (mode $mode) $pub"
      [ "$mode" = "600" ] || { echo "            mode should be 600"; rc="$EX_FAIL"; }
    fi
    command -v sops >/dev/null 2>&1 || { echo "sops:       not installed"; [ "$rc" -ne 0 ] || rc="$EX_DEPS"; }
    if [ ! -f "$CC_SECRETS_FILE" ]; then
      echo "store:      none at $REL_STORE — first machine: secrets init --first"
      [ "$rc" -ne 0 ] || rc="$EX_CONFIG"
    else
      list="$(cc_secrets_list "$CC_SECRETS_FILE")"
      nset="$(printf '%s\n' "$list" | grep -c "	enc$" || true)"
      nplain="$(printf '%s\n' "$list" | grep -c "	plain$" || true)"
      echo "store:      $REL_STORE — $nset set"
      if [ "$nplain" -gt 0 ]; then
        echo "            $nplain value(s) NOT encrypted — see secrets/README.md"; rc="$EX_FAIL"
      fi
      if [ -n "$pub" ]; then
        if cc_secrets_recipients "$CC_SECRETS_FILE" | grep -qxF "$pub"; then
          echo "recipient:  yes — this machine can read the store"
        else
          echo "recipient:  no — on a manager: secrets admit $HOST"; [ "$rc" -ne 0 ] || rc="$EX_LOCKED"
        fi
      fi
      if [ -f "$BACKUP_PUB" ]; then
        echo "backup key: secrets/backup.pub present"
      else
        echo "backup key: none yet — run: secrets backup-key (in a terminal)"
      fi
    fi
    exit "$rc"
    ;;

  check)
    [ $# -eq 0 ] || { cc_usage >&2; exit "$EX_USAGE"; }
    [ -f "$EXAMPLE" ] || cc_die "$EX_CONFIG" "no $EXAMPLE to compare against"
    have=""
    [ -f "$CC_SECRETS_FILE" ] && have="$(cc_secrets_list "$CC_SECRETS_FILE")"
    missing=0
    for k in $(cc_secrets_list "$EXAMPLE" | cut -f1); do
      st="$(printf '%s\n' "$have" | awk -F '\t' -v k="$k" '$1 == k {print $2; exit}')"
      case "$st" in
        enc) printf '  set      %s\n' "$k" ;;
        plain) printf '  PLAIN    %s (not encrypted)\n' "$k"; missing=$((missing + 1)) ;;
        *) printf '  missing  %s\n' "$k"; missing=$((missing + 1)) ;;
      esac
    done
    extra="$(printf '%s\n' "$have" | awk -F '\t' 'NF' | cut -f1 | grep -vxF -f <(cc_secrets_list "$EXAMPLE" | cut -f1) | grep -c . || true)"
    [ "$extra" -eq 0 ] || printf '  (+%s more not in secrets.example.yaml)\n' "$extra"
    [ "$missing" -eq 0 ] || exit "$EX_CONFIG"
    exit "$EX_OK"
    ;;

  init)
    first=0
    while [ $# -gt 0 ]; do
      case "$1" in
        --first) first=1; shift ;;
        --no-commit) commit=0; shift ;;
        *) cc_usage >&2; exit "$EX_USAGE" ;;
      esac
    done
    cc_need age-keygen
    cc_sops_need
    mf="$MACHINES/$HOST.md"
    [ -f "$mf" ] || cc_die "$EX_CONFIG" "no docs/machines/$HOST.md — this machine isn't mapped yet (run /setup)"
    if [ "$first" -eq 1 ] && [ -f "$CC_SECRETS_FILE" ]; then
      cc_die "$EX_USAGE" "$REL_STORE already exists — --first is for the first machine only; use: secrets init"
    fi
    pull
    if [ -f "$SOPS_AGE_KEY_FILE" ]; then
      cc_info "key: keeping the existing $SOPS_AGE_KEY_FILE"
    else
      kd="$(dirname "$SOPS_AGE_KEY_FILE")"
      mkdir -p "$kd"; chmod 700 "$kd"
      (umask 077; age-keygen -o "$SOPS_AGE_KEY_FILE" 2>/dev/null) || cc_die "$EX_FAIL" "age-keygen failed"
      chmod 600 "$SOPS_AGE_KEY_FILE"
      cc_info "key: created $SOPS_AGE_KEY_FILE (mode 600)"
    fi
    pub="$(cc_age_pub)"
    valid_recipient "$pub" || cc_die "$EX_FAIL" "could not read a public key from $SOPS_AGE_KEY_FILE"
    set_machine_recipient "$mf" "$pub"
    cc_info "recorded age_recipient in docs/machines/$HOST.md"
    write_sops_config
    paths="docs/machines/$HOST.md .sops.yaml"
    if [ "$first" -eq 1 ]; then
      mkdir -p "$(dirname "$CC_SECRETS_FILE")"
      printf '{}\n' > "$CC_SECRETS_FILE"
      (cd "$CC_ROOT" && sops --config "$CC_SOPS_CONFIG" encrypt -i "$CC_SECRETS_FILE") ||
        { rm -f "$CC_SECRETS_FILE"; cc_die "$EX_FAIL" "sops could not create the store"; }
      cc_info "store: created $REL_STORE (empty, encrypted to this machine)"
      paths="$paths $REL_STORE"
    fi
    # shellcheck disable=SC2086
    commit_paths "init $HOST" $paths
    if [ "$first" -eq 1 ]; then
      cc_info "next, in a terminal: secrets backup-key, then secrets backup-verify"
    elif [ -f "$CC_SECRETS_FILE" ] && ! cc_secrets_recipients "$CC_SECRETS_FILE" | grep -qxF "$pub"; then
      cc_info "next, on a machine that can already read the store: git pull && secrets admit $HOST"
    fi
    ;;

  set)
    target=""; from=""; stdin=0
    while [ $# -gt 0 ]; do
      case "$1" in
        --from-file) from="${2:?--from-file needs a path}"; shift 2 ;;
        --stdin) stdin=1; shift ;;
        --no-commit) commit=0; shift ;;
        -*) cc_usage >&2; exit "$EX_USAGE" ;;
        *) [ -z "$target" ] || { cc_usage >&2; exit "$EX_USAGE"; }; target="$1"; shift ;;
      esac
    done
    name="${target%%.*}"; field="${target#*.}"
    if [ "$field" = "$target" ] || ! cc_secret_name_ok "$name" "$field"; then
      cc_die "$EX_USAGE" "want <name>.<field>, e.g. tavily.api_key"
    fi
    store_needed
    cc_sops_need
    if [ -n "$from" ]; then
      [ -r "$from" ] || cc_die "$EX_USAGE" "cannot read $from"
      [ -s "$from" ] || cc_die "$EX_USAGE" "$from is empty"
      lock; pull
      cc_sops_set "$name" "$field" < "$from"
    elif [ "$stdin" -eq 0 ]; then
      # Typed values are human-only: Claude has no terminal, and settings.json denies --stdin.
      [ -t 0 ] || cc_die "$EX_USAGE" "no terminal to prompt on: run it yourself, or use --from-file PATH"
      printf 'value for %s (hidden): ' "$target" >&2
      IFS= read -rs value; printf '\n' >&2
      [ -n "$value" ] || cc_die "$EX_USAGE" "empty value: nothing stored"
      lock; pull
      printf '%s' "$value" | cc_sops_set "$name" "$field"
      value=""
    else
      value="$(cat)"
      [ -n "$value" ] || cc_die "$EX_USAGE" "empty value on stdin: nothing stored"
      lock; pull
      printf '%s' "$value" | cc_sops_set "$name" "$field"
      value=""
    fi
    cc_info "stored $target"
    commit_paths "set $target" "$REL_STORE"
    ;;

  import-env)
    file=""; maps=""; dry=0; overwrite=0
    while [ $# -gt 0 ]; do
      case "$1" in
        --map) maps="$maps${2:?--map needs NAME=name.field}
"; shift 2 ;;
        --dry-run) dry=1; shift ;;
        --overwrite) overwrite=1; shift ;;
        --no-commit) commit=0; shift ;;
        -*) cc_usage >&2; exit "$EX_USAGE" ;;
        *) [ -z "$file" ] || { cc_usage >&2; exit "$EX_USAGE"; }; file="$1"; shift ;;
      esac
    done
    [ -n "$file" ] || { cc_usage >&2; exit "$EX_USAGE"; }
    [ -r "$file" ] || cc_die "$EX_USAGE" "cannot read $file"
    if [ "$dry" -eq 0 ]; then store_needed; cc_sops_need; lock; pull; fi
    have=""
    [ -f "$CC_SECRETS_FILE" ] && have="$(cc_secrets_list "$CC_SECRETS_FILE")"
    n_set=0; n_skip=0; n_bad=0; lineno=0
    while IFS= read -r line || [ -n "$line" ]; do
      lineno=$((lineno + 1))
      line="${line#"${line%%[![:space:]]*}"}"
      case "$line" in "" | "#"*) continue ;; esac
      case "$line" in export[[:space:]]*) line="${line#export}"; line="${line#"${line%%[![:space:]]*}"}" ;; esac
      ename="${line%%=*}"
      if [ "$ename" = "$line" ]; then cc_err "line $lineno: not NAME=value, skipped"; n_bad=$((n_bad + 1)); continue; fi
      ename="${ename%"${ename##*[![:space:]]}"}"
      case "$ename" in "" | [0-9]* | *[!A-Za-z0-9_]*)
        cc_err "line $lineno: not a variable name, skipped"; n_bad=$((n_bad + 1)); continue ;;
      esac
      val="${line#*=}"
      val="${val#"${val%%[![:space:]]*}"}"
      case "$val" in
        \"*)
          rest="${val#\"}"
          case "$rest" in *\"*) ;; *) cc_err "line $lineno: $ename has an unterminated quote (multi-line values aren't supported), skipped"; n_bad=$((n_bad + 1)); continue ;; esac
          val="${rest%\"*}"
          val="${val//\\\"/\"}"; val="${val//\\\$/\$}"; val="${val//\\\\/\\}"
          ;;
        \'*)
          rest="${val#\'}"
          case "$rest" in *\'*) ;; *) cc_err "line $lineno: $ename has an unterminated quote, skipped"; n_bad=$((n_bad + 1)); continue ;; esac
          val="${rest%\'*}"
          ;;
        *)
          val="${val%%[[:space:]]#*}"
          val="${val%"${val##*[![:space:]]}"}"
          ;;
      esac
      path="$(printf '%s' "$maps" | awk -F= -v n="$ename" '$1 == n {sub(/^[^=]*=/, ""); print; exit}')"
      [ -n "$path" ] || path="$(cc_env_path "$ename")"
      pn="${path%%.*}"; pf="${path#*.}"
      if [ "$pf" = "$path" ] || ! cc_secret_name_ok "$pn" "$pf"; then
        cc_err "line $lineno: $ename maps to '$path', not <name>.<field>; skipped"; n_bad=$((n_bad + 1)); continue
      fi
      if [ -z "$val" ]; then
        printf '  empty  %s → %s (skipped)\n' "$ename" "$path"; n_skip=$((n_skip + 1)); continue
      fi
      if [ "$overwrite" -eq 0 ] && printf '%s\n' "$have" | grep -qxF "$path	enc"; then
        printf '  skip   %s → %s (already set; --overwrite replaces)\n' "$ename" "$path"; n_skip=$((n_skip + 1)); continue
      fi
      if [ "$dry" -eq 1 ]; then
        printf '  would  %s → %s\n' "$ename" "$path"
      else
        printf '%s' "$val" | cc_sops_set "$pn" "$pf"
        printf '  set    %s → %s\n' "$ename" "$path"
      fi
      val=""
      n_set=$((n_set + 1))
    done < "$file"
    if [ "$dry" -eq 1 ]; then
      printf '%s would be set, %s skipped, %s unreadable — dry run, nothing written\n' "$n_set" "$n_skip" "$n_bad"
      exit "$EX_OK"
    fi
    printf '%s set, %s skipped, %s unreadable\n' "$n_set" "$n_skip" "$n_bad"
    [ "$n_set" -eq 0 ] || commit_paths "import $n_set from $(basename "$file")" "$REL_STORE"
    [ "$n_bad" -eq 0 ] || exit "$EX_FAIL"
    ;;

  recipients)
    check=0
    while [ $# -gt 0 ]; do
      case "$1" in
        --check) check=1; shift ;;
        --no-commit) commit=0; shift ;;
        *) cc_usage >&2; exit "$EX_USAGE" ;;
      esac
    done
    list="$(expected_recipients)"
    want="$(render_sops_config "$list")"
    if [ "$check" -eq 1 ]; then
      rc=0
      if [ "$(cat "$CC_SOPS_CONFIG" 2>/dev/null || true)" != "$want" ]; then
        echo ".sops.yaml: out of date — run: secrets recipients"; rc="$EX_FAIL"
      else
        echo ".sops.yaml: matches the machine files and backup.pub"
      fi
      if [ -f "$CC_SECRETS_FILE" ]; then
        a="$(printf '%s\n' "$list" | awk 'NF {print $2}' | sort)"
        b="$(cc_secrets_recipients "$CC_SECRETS_FILE" | sort)"
        if [ "$a" != "$b" ]; then
          echo "store:      encrypted to a different set — on a manager: secrets admit <host> (or revoke)"; rc="$EX_FAIL"
        else
          echo "store:      encrypted to exactly these recipients"
        fi
      fi
      exit "$rc"
    fi
    printf '%s\n' "$list" | awk 'NF {printf "  %-16s %s\n", $1, $2}'
    write_sops_config
    commit_paths "recipients" .sops.yaml
    ;;

  admit)
    h=""
    while [ $# -gt 0 ]; do
      case "$1" in --no-commit) commit=0; shift ;; -*) cc_usage >&2; exit "$EX_USAGE" ;; *) h="$1"; shift ;; esac
    done
    [ -n "$h" ] || { cc_usage >&2; exit "$EX_USAGE"; }
    cc_sops_need; store_needed
    lock; pull
    [ -f "$MACHINES/$h.md" ] || cc_die "$EX_CONFIG" "no docs/machines/$h.md — pull, or run secrets init on $h first"
    r="$(machine_recipient "$MACHINES/$h.md")"
    [ -n "$r" ] || cc_die "$EX_CONFIG" "docs/machines/$h.md has no age_recipient — run secrets init on $h, then pull"
    write_sops_config
    updatekeys
    cc_info "admitted $h — it can read the store after a git pull"
    commit_paths "admit $h" .sops.yaml "$REL_STORE"
    ;;

  revoke)
    h=""
    while [ $# -gt 0 ]; do
      case "$1" in --no-commit) commit=0; shift ;; -*) cc_usage >&2; exit "$EX_USAGE" ;; *) h="$1"; shift ;; esac
    done
    [ -n "$h" ] || { cc_usage >&2; exit "$EX_USAGE"; }
    [ "$h" != "$HOST" ] || cc_die "$EX_USAGE" "revoke another machine from a manager that stays; this one is $HOST"
    cc_sops_need; store_needed
    lock; pull
    paths=".sops.yaml $REL_STORE"
    if [ -f "$MACHINES/$h.md" ]; then
      set_machine_recipient "$MACHINES/$h.md" ""
      paths="$paths docs/machines/$h.md"
    fi
    write_sops_config
    updatekeys
    (cd "$CC_ROOT" && sops rotate -i "$CC_SECRETS_FILE") >/dev/null 2>&1 || cc_die "$EX_FAIL" "sops rotate failed"
    # shellcheck disable=SC2086
    commit_paths "revoke $h" $paths
    echo "revoked $h: it can't open new versions of the store. Old commits still hold values it"
    echo "could read, so rotate each of these at its provider (/rotate <name>):"
    cc_secrets_list "$CC_SECRETS_FILE" | awk -F '\t' '$2 == "enc" {print "  " $1}'
    ;;

  push)
    cc_die "$EX_CONFIG" "per-box secret files are designed, not built: see secrets/README.md (Headless boxes)"
    ;;

  backup-key)
    replace=0
    while [ $# -gt 0 ]; do
      case "$1" in --replace) replace=1; shift ;; --no-commit) commit=0; shift ;; *) cc_usage >&2; exit "$EX_USAGE" ;; esac
    done
    need_tty "backup-key"
    cc_need age-keygen; cc_sops_need; store_needed
    if [ -f "$BACKUP_PUB" ] && [ "$replace" -eq 0 ]; then
      cc_die "$EX_USAGE" "secrets/backup.pub exists. --replace makes a new paper key (the old one stops opening new versions)"
    fi
    lock; pull
    key="$(age-keygen 2>/dev/null | grep '^AGE-SECRET-KEY-')"
    pub="$(printf '%s\n' "$key" | age-keygen -y)"
    cat <<EOF

Your paper backup key. Write it down by hand, twice, on two sheets kept in two places.
Never photograph it, type it into a note, or paste it anywhere. Groups of six, for copying:

EOF
    printf '%s\n' "$key" | fold -w 6 |
      awk '{a = a (NR % 6 == 1 ? "" : " ") $0; if (NR % 6 == 0) {print "    " a; a = ""}} END {if (a != "") print "    " a}'
    printf '\nPress Enter once both copies are written down and checked. '
    IFS= read -r _
    key=""
    printf '\033[2J\033[3J\033[H'
    { echo "# Public half of the paper backup key; the private half is on paper only."
      echo "# Created $(date +%Y-%m-%d) by secrets backup-key."
      echo "$pub"; } > "$BACKUP_PUB"
    write_sops_config
    updatekeys
    commit_paths "backup key" secrets/backup.pub .sops.yaml "$REL_STORE"
    echo "backup key added to the store's recipients. Now prove the paper copy: secrets backup-verify"
    ;;

  backup-verify)
    [ $# -eq 0 ] || { cc_usage >&2; exit "$EX_USAGE"; }
    need_tty "backup-verify"
    cc_need age-keygen sops; store_needed
    [ -f "$BACKUP_PUB" ] || cc_die "$EX_CONFIG" "no secrets/backup.pub — run: secrets backup-key"
    printf 'type the paper key (spaces and case do not matter; hidden): '
    IFS= read -rs typed; printf '\n'
    typed="$(printf '%s' "$typed" | tr -d '[:space:]' | tr '[:lower:]' '[:upper:]')"
    want="$(grep -m1 '^age1' "$BACKUP_PUB")"
    got="$(printf '%s\n' "$typed" | age-keygen -y 2>/dev/null || true)"
    if [ "$got" != "$want" ]; then
      typed=""; cc_die "$EX_FAIL" "that is not the key in secrets/backup.pub — check each group and try again"
    fi
    vt="$(mktemp -d)"; chmod 700 "$vt"
    trap 'rm -rf "$vt"' EXIT
    (umask 077; printf '%s\n' "$typed" > "$vt/keys.txt")
    typed=""
    # A hermetic HOME, so sops can only have used the paper key, not this machine's.
    if env -u SOPS_AGE_KEY -u SOPS_AGE_KEY_CMD HOME="$vt" SOPS_AGE_KEY_FILE="$vt/keys.txt" \
        sops decrypt "$CC_SECRETS_FILE" >/dev/null 2>&1; then
      rm -rf "$vt"
      echo "ok: the paper key opens $REL_STORE"
    else
      rm -rf "$vt"
      cc_die "$EX_FAIL" "the paper key matches backup.pub but can't open the store — run: secrets recipients --check"
    fi
    ;;

  env)
    parse_selection "$@"
    export_lines
    ;;

  exec)
    sel=""
    while [ $# -gt 0 ] && [ "$1" != "--" ]; do sel="$sel$1
"; shift; done
    [ "${1:-}" = "--" ] || cc_die "$EX_USAGE" "usage: secrets exec (--only NAME,… | --all-env) -- <command> [args…]"
    shift
    [ $# -gt 0 ] || cc_die "$EX_USAGE" "no command after --"
    oldifs="$IFS"; IFS='
'
    # shellcheck disable=SC2086
    parse_selection $sel
    IFS="$oldifs"
    lines="$(export_lines)"
    eval "$lines"
    lines=""
    exec "$@"
    ;;

  *)
    cc_usage >&2; exit "$EX_USAGE"
    ;;
esac
