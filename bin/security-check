#!/usr/bin/env bash
# security-check — check this machine against the fleet security baseline.
#
# Usage:
#   security-check [--ssh off|on]     expected sshd state (default: read `ssh:` from the map,
#                                     else off). "on" means listening, key-only.
#   ssh box 'bash -s -- --ssh on' < bin/security-check     run on a headless box
#
# Checks: FileVault / disk encryption · firewall · sshd state matches the machine's role ·
#         password SSH disabled wherever sshd runs · browse profiles private ·
#         Agent Reach's config (cookies, keys) private ·
#         the vault's and every client repo's GitHub remote is not public ·
#         age key private (mode 600, dir 700, outside any repo, holds only this machine's key) ·
#         every value in the secrets store encrypted · this instance's own remote private ·
#         Tailscale up.
#
# Self-contained on purpose (no lib/ sourcing) so it can be piped to a box over SSH.
# Output: one line per check, "PASS|FAIL|SKIP <check> — <detail>", prefixed with [<host>].
# Exit codes: 0 all pass · 1 at least one FAIL · 2 usage
set -uo pipefail

usage() { awk 'NR==1 && /^#!/ {next} /^#/ {sub(/^# ?/, ""); print; next} {exit}' "$0"; }

expect_ssh=""
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --ssh) expect_ssh="${2:-}"; shift 2 ;;
    *) usage >&2; exit 2 ;;
  esac
done

os="$(uname -s)"
if [ "$os" = "Darwin" ]; then host="$(scutil --get LocalHostName 2>/dev/null || hostname -s)"; else host="$(hostname -s)"; fi

# Default the expectation from the map when run inside the repo.
if [ -z "$expect_ssh" ]; then
  map="$(cd "$(dirname "$0")/.." 2>/dev/null && pwd)/docs/machines/$host.md"
  if [ -f "$map" ]; then
    v="$(awk '/^---$/{n++; next} n==1 && /^ssh:/ {sub(/^ssh:[ ]*/, ""); sub(/[ ]*#.*/, ""); print; exit}' "$map")"
    case "$v" in off|"") expect_ssh="off" ;; *) expect_ssh="on" ;; esac
  else
    expect_ssh="off"
  fi
fi
case "$expect_ssh" in off|on) ;; *) usage >&2; exit 2 ;; esac

fails=0
report() { # status check detail
  printf '[%s] %-4s %s — %s\n' "$host" "$1" "$2" "$3"
  [ "$1" = "FAIL" ] && fails=$((fails + 1))
  return 0
}

# --- Disk encryption -------------------------------------------------------
if [ "$os" = "Darwin" ]; then
  if fdesetup status 2>/dev/null | grep -q "FileVault is On"; then
    report PASS filevault "on"
  else
    report FAIL filevault "$(fdesetup status 2>/dev/null | head -1)"
  fi
elif command -v lsblk >/dev/null 2>&1; then
  if lsblk -o TYPE 2>/dev/null | grep -q crypt; then
    report PASS disk-encryption "LUKS volume present"
  else
    report FAIL disk-encryption "no encrypted volume found"
  fi
else
  report SKIP disk-encryption "no lsblk"
fi

# --- Firewall --------------------------------------------------------------
if [ "$os" = "Darwin" ]; then
  fw="/usr/libexec/ApplicationFirewall/socketfilterfw"
  if "$fw" --getglobalstate 2>/dev/null | grep -qi "enabled"; then
    report PASS firewall "enabled"
  else
    report FAIL firewall "disabled"
  fi
elif command -v ufw >/dev/null 2>&1; then
  if ufw status 2>/dev/null | grep -q "Status: active"; then
    report PASS firewall "ufw active"
  else
    report FAIL firewall "ufw inactive (or needs sudo)"
  fi
elif command -v nft >/dev/null 2>&1 && nft list ruleset 2>/dev/null | grep -q "chain input"; then
  report PASS firewall "nftables input chain present"
else
  report SKIP firewall "no ufw/nftables visible (try with sudo)"
fi

# --- sshd state vs role ----------------------------------------------------
listening=0
if (exec 3<>/dev/tcp/127.0.0.1/22) 2>/dev/null; then listening=1; fi

if [ "$expect_ssh" = "off" ]; then
  if [ "$listening" -eq 0 ]; then
    report PASS sshd "off, as the role expects"
  else
    report FAIL sshd "listening on :22 but the map says ssh: off"
  fi
else
  if [ "$listening" -eq 1 ]; then
    report PASS sshd "on, as the role expects"
  elif command -v tailscale >/dev/null 2>&1 && tailscale debug prefs 2>/dev/null | grep -q '"RunSSH": true'; then
    report PASS sshd "Tailscale SSH serves this box"
  else
    report FAIL sshd "not listening but the map expects SSH"
  fi
fi

# --- Password SSH disabled -------------------------------------------------
if [ "$listening" -eq 1 ]; then
  cfgs=""
  for f in /etc/ssh/sshd_config.d/*.conf /etc/ssh/sshd_config; do [ -r "$f" ] && cfgs="$cfgs $f"; done
  if [ -z "$cfgs" ]; then
    report SKIP password-ssh "sshd_config not readable"
  else
    # sshd uses the FIRST value it reads; drop-ins are read before the main file.
    # shellcheck disable=SC2086
    first() { awk -v k="$1" 'tolower($1)==tolower(k) {print tolower($2); exit}' $cfgs; }
    pw="$(first PasswordAuthentication)"; kbd="$(first KbdInteractiveAuthentication)"
    if [ "$pw" = "no" ] && [ "$kbd" != "yes" ]; then
      report PASS password-ssh "disabled"
    else
      report FAIL password-ssh "PasswordAuthentication=${pw:-default(yes)} KbdInteractiveAuthentication=${kbd:-default}"
    fi
  fi
else
  report SKIP password-ssh "sshd not running"
fi

# --- browse profiles (logged-in state) --------------------------------------
prof="$HOME/.config/browse/profiles"
if [ ! -d "$prof" ]; then
  report SKIP browse-profiles "none"
else
  if [ "$os" = "Darwin" ]; then mode="$(stat -f '%Lp' "$prof")"; else mode="$(stat -c '%a' "$prof")"; fi
  if [ "$mode" != "700" ]; then
    report FAIL browse-profiles "$prof is mode $mode, expected 700"
  elif git -C "$prof" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    report FAIL browse-profiles "$prof is inside a git work tree"
  else
    report PASS browse-profiles "private, outside any repo"
  fi
fi

# --- Agent Reach config (cookies and keys, if the human added a channel) ------
arc="$HOME/.agent-reach/config.yaml"
if [ ! -f "$arc" ]; then
  report SKIP agent-reach-config "none"
else
  if [ "$os" = "Darwin" ]; then mode="$(stat -f '%Lp' "$arc")"; else mode="$(stat -c '%a' "$arc")"; fi
  if [ "$mode" != "600" ]; then
    report FAIL agent-reach-config "$arc is mode $mode, expected 600"
  elif git -C "$HOME/.agent-reach" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    report FAIL agent-reach-config "$HOME/.agent-reach is inside a git work tree"
  else
    report PASS agent-reach-config "private, outside any repo"
  fi
fi

# --- The vault's remote must be private ------------------------------------
# The vault is the second brain: notes, people, transcripts. `vault-setup --create-remote`
# refuses a public repo, but a remote can be added or flipped by hand afterwards.
vaultdir="${CC_VAULT:-$HOME/vault}"
if [ ! -d "$vaultdir/.git" ]; then
  report SKIP vault-remote "no vault on this machine"
else
  origin="$(git -C "$vaultdir" remote get-url origin 2>/dev/null || true)"
  if [ -z "$origin" ]; then
    report PASS vault-remote "local only, no remote"
  elif ! command -v gh >/dev/null 2>&1; then
    report SKIP vault-remote "gh not installed, cannot read $origin's visibility"
  else
    slug="$(printf '%s' "$origin" | sed -e 's#^.*github\.com[:/]##' -e 's#\.git$##')"
    case "$(gh repo view "$slug" --json visibility --jq .visibility 2>/dev/null || true)" in
      PUBLIC)            report FAIL vault-remote "$slug is PUBLIC — your notes are on the open internet" ;;
      PRIVATE|INTERNAL)  report PASS vault-remote "$slug is private" ;;
      *)                 report SKIP vault-remote "could not read visibility of $slug" ;;
    esac
  fi
fi


# --- Client repos must be private --------------------------------------------
# A client folder is a repo holding the client's own documents (brief/). `new-client` creates it
# private; a hand-made remote or a flipped setting is what this catches.
clients="${CC_CLIENTS:-$HOME/clients}"
found=0; public=""; unknown=""
for d in "$clients"/*/; do
  [ -d "$d.git" ] || continue
  found=$((found + 1))
  origin="$(git -C "$d" remote get-url origin 2>/dev/null || true)"
  [ -n "$origin" ] || continue
  command -v gh >/dev/null 2>&1 || { unknown="$unknown $(basename "$d")"; continue; }
  slug="$(printf '%s' "$origin" | sed -e 's#^.*github\.com[:/]##' -e 's#\.git$##')"
  case "$(gh repo view "$slug" --json visibility --jq .visibility 2>/dev/null || true)" in
    PUBLIC) public="$public $slug" ;;
    PRIVATE|INTERNAL) ;;
    *) unknown="$unknown $slug" ;;
  esac
done
if [ "$found" -eq 0 ]; then
  report SKIP client-remotes "no client repos in $clients"
elif [ -n "$public" ]; then
  report FAIL client-remotes "PUBLIC:$public — client documents are on the open internet"
elif [ -n "$unknown" ]; then
  report SKIP client-remotes "could not read visibility of:$unknown"
else
  report PASS client-remotes "$found client repos, none public"
fi

# --- The age key: private, outside any repo, and only this machine's ---------
# The key file is the credential for every secret, unencrypted at rest except by FileVault.
# The paper backup key's private half belongs on paper: on disk it is one more copy to lose.
repo="$(cd "$(dirname "$0")/.." 2>/dev/null && pwd)"
agekey="${SOPS_AGE_KEY_FILE:-$HOME/.config/sops/age/keys.txt}"
fmode() { if [ "$os" = "Darwin" ]; then stat -f '%Lp' "$1"; else stat -c '%a' "$1"; fi; }
if [ ! -f "$agekey" ]; then
  report SKIP age-key "no age key on this machine"
else
  problems=""
  [ "$(fmode "$agekey")" = "600" ] || problems="$problems; $agekey is mode $(fmode "$agekey"), expected 600"
  [ "$(fmode "$(dirname "$agekey")")" = "700" ] || problems="$problems; $(dirname "$agekey") is mode $(fmode "$(dirname "$agekey")"), expected 700"
  if git -C "$(dirname "$agekey")" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    problems="$problems; it is inside a git work tree"
  fi
  n="$(grep -c '^AGE-SECRET-KEY-' "$agekey" 2>/dev/null || true)"
  [ "${n:-0}" -le 1 ] || problems="$problems; it holds $n keys — the paper backup key belongs on paper only"
  if [ -f "$repo/secrets/backup.pub" ] && command -v age-keygen >/dev/null 2>&1; then
    bp="$(grep -m1 '^age1' "$repo/secrets/backup.pub" 2>/dev/null || true)"
    if [ -n "$bp" ] && age-keygen -y "$agekey" 2>/dev/null | grep -qxF "$bp"; then
      problems="$problems; it is the paper backup key — that belongs on paper only"
    fi
  fi
  if [ -d "$repo/.git" ] && git -C "$repo" grep -qE 'AGE-SECRET-KEY-1[0-9A-Z]{58}' 2>/dev/null; then
    problems="$problems; an age private key is committed in $repo"
  fi
  if [ -n "$problems" ]; then
    report FAIL age-key "${problems#; }"
  else
    report PASS age-key "mode 600, outside any repo, one key"
  fi
fi

# --- Every value in the secrets store is encrypted -----------------------------
# Key names are plaintext in a sops file; values must all be ENC[…] (sops leaves "" as is).
stores=""
for f in "$repo/secrets/secrets.yaml" "$repo"/secrets/hosts/*.yaml; do [ -f "$f" ] && stores="$stores $f"; done
if [ -z "$stores" ]; then
  report SKIP secrets-encrypted "no secrets store in $repo"
else
  plain=""
  for f in $stores; do
    grep -q '^sops:' "$f" || { plain="$plain ${f#"$repo"/}(not a sops file)"; continue; }
    # name.field of each value that is neither ENC[…] nor empty; mirrors cc_secrets_list in lib/common.sh
    bad="$(awk '
      /^[[:space:]]*(#|$)/ {next}
      /^[^[:space:]]/ {top = $0; sub(/:.*/, "", top); ind = 0
        v = $0; sub(/^[^:]*:[ ]*/, "", v); sub(/[ ]+#.*$/, "", v)
        if (top != "sops" && v != "" && v != "{}" && v !~ /^ENC\[/) print top; next}
      top == "sops" {next}
      {match($0, /^[ ]+/); cur = RLENGTH; if (ind == 0) ind = cur
        if (cur > ind) {print top ".(nested)"; next}
        line = substr($0, cur + 1); k = line; sub(/:.*/, "", k)
        v = line; sub(/^[^:]*:[ ]*/, "", v); sub(/[ ]+#.*$/, "", v)
        if (v !~ /^ENC\[/ && v != "" && v != "\"\"") print top "." k}' "$f" | sort -u | tr '\n' ' ')"
    [ -z "$bad" ] || plain="$plain ${f#"$repo"/}: $bad"
  done
  if [ -n "$plain" ]; then
    report FAIL secrets-encrypted "plaintext in the store:$plain"
  else
    report PASS secrets-encrypted "every value is ENC[…]"
  fi
fi

# --- This instance's own remote must be private ---------------------------------
# The instance holds the machine map and, once secrets/ is in use, the encrypted store, whose key
# names say which services you use. The public template (marked by .template) is exempt.
if [ ! -d "$repo/.git" ] && ! git -C "$repo" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  report SKIP instance-remote "not run from inside the instance"
elif [ -f "$repo/.template" ]; then
  report SKIP instance-remote "this is the public template"
else
  origin="$(git -C "$repo" remote get-url origin 2>/dev/null || true)"
  if [ -z "$origin" ]; then
    report PASS instance-remote "local only, no remote"
  elif ! command -v gh >/dev/null 2>&1; then
    report SKIP instance-remote "gh not installed, cannot read $origin's visibility"
  else
    slug="$(printf '%s' "$origin" | sed -e 's#^.*github\.com[:/]##' -e 's#\.git$##')"
    case "$(gh repo view "$slug" --json visibility --jq .visibility 2>/dev/null || true)" in
      PUBLIC)            report FAIL instance-remote "$slug is PUBLIC — your machine map and secret names are on the open internet" ;;
      PRIVATE|INTERNAL)  report PASS instance-remote "$slug is private" ;;
      *)                 report SKIP instance-remote "could not read visibility of $slug" ;;
    esac
  fi
fi

# --- Tailscale -------------------------------------------------------------
ts=""
for c in tailscale /Applications/Tailscale.app/Contents/MacOS/Tailscale; do
  command -v "$c" >/dev/null 2>&1 && { ts="$c"; break; }
done
if [ -z "$ts" ]; then
  report FAIL tailscale "not installed"
else
  state="$("$ts" status --json 2>/dev/null | awk -F'"' '/"BackendState"/ {print $4; exit}')"
  if [ "$state" = "Running" ]; then
    report PASS tailscale "up"
  else
    report FAIL tailscale "state: ${state:-unknown}"
  fi
fi

[ "$fails" -eq 0 ]
