#!/usr/bin/env bash
# exa — semantic web search via Exa. Markdown out by default.
#
# Usage:
#   exa "query" [-n N] [--chars N] [--json]
#
#   -n N        results (default 5)
#   --chars N   text excerpt per result (default 800)
#   --json      raw API response
#
# Secret: Bitwarden item "claude-computer/exa", password field = API key.
# Exit codes: 0 ok · 1 API error · 2 usage · 3 curl/jq/bw missing · 4 locked · 5 item missing
set -euo pipefail
. "$(dirname "$0")/../lib/common.sh"
cc_wants_help "$@"
cc_need curl jq

n=5; chars=800; json=0; query=""
while [ $# -gt 0 ]; do
  case "$1" in
    -n) n="${2:?}"; shift 2 ;;
    --chars) chars="${2:?}"; shift 2 ;;
    --json) json=1; shift ;;
    -*) cc_usage >&2; exit "$EX_USAGE" ;;
    *) query="${query:+$query }$1"; shift ;;
  esac
done
[ -n "$query" ] || { cc_usage >&2; exit "$EX_USAGE"; }

key="$(cc_secret exa)"
body="$(jq -n --arg q "$query" --argjson n "$n" --argjson c "$chars" \
  '{query:$q, type:"auto", numResults:$n, contents:{text:{maxCharacters:$c}}}')"
resp="$(cc_curl "x-api-key: $key" -H 'Content-Type: application/json' \
  -d "$body" https://api.exa.ai/search)" || cc_die "$EX_FAIL" "API error: $resp"

if [ "$json" -eq 1 ]; then printf '%s\n' "$resp"; exit 0; fi
printf '%s' "$resp" | jq -r '.results[] | "## [\(.title // .url)](\(.url))\n\n\(.text // "")\n"'
