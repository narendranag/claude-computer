{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "PAGER": "cat",
    "GIT_PAGER": "cat",
    "GH_PAGER": "cat",
    "NO_COLOR": "1"
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)",
      "Bash(gh repo view:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(rg:*)",
      "Bash(fd:*)",
      "Bash(jq:*)",
      "Bash(yq:*)",
      "Bash(tree:*)",
      "Bash(which:*)",
      "Bash(brew list:*)",
      "Bash(brew info:*)",
      "Bash(brew leaves:*)",
      "Bash(brew bundle check:*)",
      "Bash(tailscale status:*)",
      "Bash(~/claude-computer/bin/map-check:*)",
      "Bash(~/claude-computer/bin/security-check:*)",
      "Bash(~/claude-computer/bin/tasks-sync:*)",
      "Bash(~/claude-computer/bin/tg-send:*)",
      "Bash(~/claude-computer/bin/dashboard:*)",
      "Bash(~/claude-computer/bin/docs-build:*)",
      "Bash(~/claude-computer/bin/tavily:*)",
      "Bash(~/claude-computer/bin/exa:*)",
      "Bash(~/claude-computer/bin/jina:*)",
      "Bash(~/claude-computer/bin/firecrawl:*)",
      "Bash(~/claude-computer/bin/archive-pull --search:*)",
      "Bash(map-check:*)",
      "Bash(security-check:*)",
      "Bash(tasks-sync:*)",
      "Bash(tg-send:*)",
      "Bash(dashboard:*)",
      "Bash(docs-build:*)",
      "Bash(tavily:*)",
      "Bash(exa:*)",
      "Bash(jina:*)",
      "Bash(firecrawl:*)",
      "Bash(archive-pull --search:*)",
      "Bash(browse:*)",
      "Bash(agent-reach doctor:*)",
      "Bash(~/claude-computer/bin/browse:*)",
      "Bash(vault-setup)",
      "Bash(vault-setup --dry-run)",
      "Bash(vault-setup --upgrade)",
      "Bash(~/claude-computer/bin/vault-setup)",
      "Bash(~/claude-computer/bin/vault-setup --dry-run)",
      "Bash(~/claude-computer/bin/vault-setup --upgrade)",
      "Bash(secrets status)",
      "Bash(~/claude-computer/bin/secrets status)",
      "Bash(secrets check)",
      "Bash(~/claude-computer/bin/secrets check)",
      "Bash(secrets recipients --check)",
      "Bash(~/claude-computer/bin/secrets recipients --check)",
      "Bash(sops filestatus:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(brew uninstall:*)",
      "Bash(rclone:*)",
      "Bash(~/claude-computer/bin/archive-push:*)",
      "Bash(~/claude-computer/bin/resources-sync:*)",
      "Bash(~/claude-computer/bin/library-push:*)",
      "Bash(~/claude-computer/bin/new-app:*)",
      "Bash(~/claude-computer/bin/new-client:*)",
      "Bash(sudo:*)",
      "Bash(rg --pre*)",
      "Bash(rg * --pre*)",
      "Bash(rg --hostname-bin*)",
      "Bash(rg * --hostname-bin*)",
      "Bash(agent-reach install:*)",
      "Bash(agent-reach configure:*)",
      "Bash(agent-reach uninstall:*)",
      "Bash(archive-push:*)",
      "Bash(resources-sync:*)",
      "Bash(library-push:*)",
      "Bash(new-app:*)",
      "Bash(new-client:*)",
      "Bash(vault-setup --create-remote*)",
      "Bash(vault-setup * --create-remote*)",
      "Bash(~/claude-computer/bin/vault-setup --create-remote*)",
      "Bash(~/claude-computer/bin/vault-setup * --create-remote*)",
      "Bash(secrets init:*)",
      "Bash(~/claude-computer/bin/secrets init:*)",
      "Bash(secrets set:*)",
      "Bash(~/claude-computer/bin/secrets set:*)",
      "Bash(secrets import-env:*)",
      "Bash(~/claude-computer/bin/secrets import-env:*)",
      "Bash(secrets admit:*)",
      "Bash(~/claude-computer/bin/secrets admit:*)",
      "Bash(secrets revoke:*)",
      "Bash(~/claude-computer/bin/secrets revoke:*)",
      "Bash(secrets push:*)",
      "Bash(~/claude-computer/bin/secrets push:*)",
      "Bash(secrets exec:*)",
      "Bash(~/claude-computer/bin/secrets exec:*)",
      "Bash(secrets recipients)",
      "Bash(~/claude-computer/bin/secrets recipients)",
      "Bash(secrets recipients --no-commit)",
      "Bash(~/claude-computer/bin/secrets recipients --no-commit)",
      "Bash(sops updatekeys:*)",
      "Bash(sops rotate:*)"
    ],
    "deny": [
      "Bash(security find-generic-password:*)",
      "Bash(security dump-keychain:*)",
      "Bash(security export:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Read(~/.ssh/id_*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.config/rclone/rclone.conf)",
      "Read(~/.config/browse/profiles/**)",
      "Read(~/.agent-reach/config.yaml)",
      "Read(~/Library/Keychains/**)",
      "Bash(sops decrypt:*)",
      "Bash(sops -d:*)",
      "Bash(sops --decrypt:*)",
      "Bash(sops edit:*)",
      "Bash(sops exec-env:*)",
      "Bash(sops exec-file:*)",
      "Bash(sops set:*)",
      "Bash(sops unset:*)",
      "Bash(sops publish:*)",
      "Bash(sops keyservice:*)",
      "Bash(sops secrets/*)",
      "Bash(sops ./secrets/*)",
      "Bash(sops ~/claude-computer/secrets/*)",
      "Bash(age -d:*)",
      "Bash(age --decrypt:*)",
      "Bash(age-keygen:*)",
      "Bash(secrets env:*)",
      "Bash(~/claude-computer/bin/secrets env:*)",
      "Bash(secrets backup-key:*)",
      "Bash(~/claude-computer/bin/secrets backup-key:*)",
      "Bash(secrets backup-verify:*)",
      "Bash(~/claude-computer/bin/secrets backup-verify:*)",
      "Bash(secrets set*--stdin*)",
      "Bash(~/claude-computer/bin/secrets set*--stdin*)",
      "Bash(cat ~/.config/sops/*)",
      "Bash(head ~/.config/sops/*)",
      "Bash(tail ~/.config/sops/*)",
      "Read(~/.config/sops/**)",
      "Edit(~/.config/sops/**)",
      "Read(~/Library/Application Support/sops/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-start.sh",
            "timeout": 90
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/prompt-submit.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/stop.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  }
}
