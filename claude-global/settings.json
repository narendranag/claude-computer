{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)",
      "Bash(gh repo view:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(rg:*)",
      "Bash(fd:*)",
      "Bash(jq:*)",
      "Bash(yq:*)",
      "Bash(tree:*)",
      "Bash(which:*)",
      "Bash(brew list:*)",
      "Bash(brew info:*)",
      "Bash(brew leaves:*)",
      "Bash(brew bundle check:*)",
      "Bash(tailscale status:*)",
      "Bash(~/system-manager/bin/map-check:*)",
      "Bash(~/system-manager/bin/security-check:*)",
      "Bash(~/system-manager/bin/tasks-sync:*)",
      "Bash(~/system-manager/bin/tg-send:*)",
      "Bash(~/system-manager/bin/tavily:*)",
      "Bash(~/system-manager/bin/exa:*)",
      "Bash(~/system-manager/bin/jina:*)",
      "Bash(~/system-manager/bin/firecrawl:*)",
      "Bash(~/system-manager/bin/secrets-unlock --status)",
      "Bash(~/system-manager/bin/archive-pull --search:*)",
      "Bash(map-check:*)",
      "Bash(security-check:*)",
      "Bash(tasks-sync:*)",
      "Bash(tg-send:*)",
      "Bash(tavily:*)",
      "Bash(exa:*)",
      "Bash(jina:*)",
      "Bash(firecrawl:*)",
      "Bash(secrets-unlock --status)",
      "Bash(archive-pull --search:*)",
      "Bash(browse:*)",
      "Bash(~/system-manager/bin/browse:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(rm:*)",
      "Bash(brew uninstall:*)",
      "Bash(rclone:*)",
      "Bash(~/system-manager/bin/archive-push:*)",
      "Bash(~/system-manager/bin/resources-sync:*)",
      "Bash(~/system-manager/bin/new-app:*)",
      "Bash(sudo:*)",
      "Bash(archive-push:*)",
      "Bash(resources-sync:*)",
      "Bash(new-app:*)"
    ],
    "deny": [
      "Bash(bw get:*)",
      "Bash(bw export:*)",
      "Bash(bw list:*)",
      "Bash(bw unlock:*)",
      "Bash(security find-generic-password:*)",
      "Bash(security dump-keychain:*)",
      "Bash(security export:*)",
      "Bash(secrets-unlock --export)",
      "Bash(~/system-manager/bin/secrets-unlock --export)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Read(~/.ssh/id_*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.config/rclone/rclone.conf)",
      "Read(~/.config/browse/profiles/**)",
      "Read(~/Library/Keychains/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-start.sh",
            "timeout": 90
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/prompt-submit.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/stop.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify.sh"
          }
        ]
      }
    ]
  }
}
